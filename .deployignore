# Paths in this repo that are NOT part of the public site.
# The Pages workflow copies the repo into _site/ minus everything listed here.
# rsync --exclude-from syntax: a leading / anchors to the repo root.

# Repo and tooling internals
/.git/
/.github/
/.githooks/
/.gitattributes
/.gitignore
/.eslintrc.json
/.eslintignore
/.deployignore
/eslint.config.cjs
/package.json
/package-lock.json
/scripts/
/data/fedramp/raw/
/data/fedramp/inbox/
/data/fedramp/grc-vendors.json
/data/fedramp/ai-vendors.json
/data/fedramp/README.md
/*.md

# Template sources and leftovers
/Archive/
/Content/
/HTML Template/
/documentation/
/app/
/owl carousel/
/test.html
/index new.html
/index-PRODUCTION-BACKUP-*.html
/styles reference.html
/faqs_new.html
/missing.txt

# Working files
/Colors.xlsx
/services blurbs.docx
/favicon.zip
*.psd

# Server-side code GitHub Pages cannot run (it would be served as plain text)
*.php

# Unreferenced leftovers (security sweep 2026-10-14) - kept in the repo, not served.
# backup/new custom.js still carry the template author's Mailchimp list URL.
/js/script.js
/js/backup custom.js
/js/new_custom.js
/js/Archive/
/js/custom.js.map
/css/style backup.css
/css/style_alt.css
/css/xstyle.css
/font/flaticon.html
