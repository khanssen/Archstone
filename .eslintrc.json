{
  "env": {
    "es2021": true,
    "node": true,
    "browser": true,
    "jquery": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "WOW": "readonly"
  },
  "rules": {
    "semi": ["error", "always"],
    "no-undef": "off",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-redeclare": "warn"
  }
}
