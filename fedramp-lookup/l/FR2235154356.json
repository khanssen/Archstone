{"id":"FR2235154356","current":{"csp":"Lastwall Corp","cso":"IDCommand","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"First Information Technology Services, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-04-25T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"DGLNFE65EYH3","service_acronym":"IDCommand","website":"https://www.lastwall.com/","sales_email":"sales@lastwall.com","security_email":"security@lastwall.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137801","status_date":"2025-04-25T04:00:00.000Z","cap_date":null,"service_desc":"IDCommand™ by Lastwall is a mission-ready Identity Platform purpose-built for the unique demands of U.S. government and defense environments.\r\nAt its core, IDCommand delivers secure, seamless access enabling a Zero Trust architecture - allowing agencies to modernize their authentication without compromising on compliance, control, or security posture.\r\n\r\nIDCommand supports the identity standards federal agencies trust - including SAML 2.0, OIDC, PIV/CAC, and FIDO2/WebAuthn - for strong, passwordless login experiences that eliminate credential vulnerabilities and streamline secure access. Whether you're operating in government, national security, or critical infrastructure, IDCommand makes it easy to implement Public Key Infrastructure (PKI) by design - so secure identity can be deployed quickly and confidently at scale.\r\n\r\nOur adaptive access engine continuously assesses risk in real time - factoring in device posture, patch levels, geographic context, and other environmental signals to deliver intelligent, policy-driven access decisions. These capabilities support alignment with key federal frameworks such as NIST SP 800-53 Rev.5 (Security and Privacy Controls for Information Systems and Organizations), NIST SP 800-63 (Digital Identity) and NIST SP 800-207 (Zero Trust architecture).\r\n\r\nEngineered for high-security domains, IDCommand integrates seamlessly into existing architectures - empowering federal teams to deploy modern identity controls that prioritize mission continuity, not complexity.","event_log":[{"date":"2025-01-21T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-02-18T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-04-25T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"02/18","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-04-25","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-04-25","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"Defense Innovation Unit","as_of":"2026-06-11","source":"old_feed","shown_until":"2026-11-03","label":"Sponsor"}},"timeline":[{"date":"2025-01-21","kind":"status","source