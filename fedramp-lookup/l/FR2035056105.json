{"id":"FR2035056105","current":{"csp":"Bluescape","cso":"Bluescape with n8n for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2022-12-13T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Collaboration","Communication","Data Management","Design & Multimedia","Education & Training","Human Resources","Law Enforcement","Marketing & Sales","Network Management","Operations Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"DQZ3P2GM1LB3","service_acronym":"Bluescape with n8n for Government","website":"https://www.bluescape.com/","sales_email":"sales@bluescape.com","security_email":"fedramp@bluescape.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"AI integrator","serviceDescription":"","dateAvailable":"2022-12-13"},{"serviceName":"Bluescape API services","serviceDescription":"","dateAvailable":"2022-12-13"},{"serviceName":"Collaborative Operations Center Feature Pack","serviceDescription":"","dateAvailable":"2022-12-13"},{"serviceName":"Enhanced Video Streaming Capabilities","serviceDescription":"","dateAvailable":"2022-12-13"},{"serviceName":"Integrations to authorized IL4 and FedRAMP Document Services","serviceDescription":"","dateAvailable":"2022-12-13"},{"serviceName":"Pattern-of-Life Profiler","serviceDescription":"","dateAvailable":"2022-12-13"},{"serviceName":"Screenshare+","serviceDescription":"","dateAvailable":"2022-12-13"},{"serviceName":"Visual Spatial Event Map","serviceDescription":"","dateAvailable":"2022-12-13"},{"serviceName":"n8n for Government by Bluescape","serviceDescription":"","dateAvailable":"2022-12-13"}],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2022-12-13T05:00:00.000Z","cap_date":null,"service_desc":"Bluescape is the secure workspace for government and defense operations, giving teams a common picture to act with speed and precision. FedRAMP-authorized and trusted across national security, it brings intelligence, plans, and imagery together in one place, so mission partners align quickly and make time-critical decisions with confidence. \r\n\r\nBluescape supports use cases such as operations centers, complex planning, intel and information analysis, and cyber/critical infrastructure monitoring.\r\n\r\nWith integrations to COTS and GOTS software packages, and a full API for custom content workflows, Bluescape supports mission partner and interagency collaboration requirements.\r\n\r\nUse the power of AI to summarize and make inquiries of document data within workspaces\r\nPlug in third-party AI and ML tools for data aggregation/analysis.\r\nn8n for Government by Bluescape\r\nAggregate and train data from multiple LLMs to produce appropriate mission analysis and other AI outputs in a secure environment.\r\nCreate pattern-of-life profiles for tracking targets and collect metadata to storyboard incident and event chronologies.\r\nVisualize and analyze geo-data\r\nStand up drone command centers with multiple live video and data feeds, sharable to unlimited mission partners.\r\nBuild your own integrations to connect to systems of record and port content upward through cross-domain solutions.\r\n \r\n\r\nBluescape has hardened its Government solution to DoD SRG IL4 control baselines and FedRAMP Moderate so that any Federal Civilian or Defense customer can create and handle rich media and operational content through any cross-domain solution -- from FedRAMP to NIPR to SIPR to JWICS.\r\n\r\nBluescape features include:\r\n\r\nDocument viewing and editing\r\nHigh-resolution image upload\r\nVideo upload + synchronized playback\r\nPresentation mode with Canvas Carousels\r\nMulti-page document export / Intelligence pkg production + exporter (PDF and PPTX)\r\nPersistent Infinite Whiteboard / Workspace\r\nLead/follow capability\r\nTask cards\r\nSupport for embedded web applications\r\nUser Access Management and Admin Console","event_log":[{"date":"2022-01-19T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-07-29T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-12-13T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"07/29","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2022-12-13","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2022-12-13","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"Defense Information Systems Agency","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Sponsor"}},"timeline":[{"date":"2022-01-19","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2022-07-29","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","t