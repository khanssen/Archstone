{"id":"FR2625525331","current":{"csp":"Clearview AI, Inc.","cso":"Clearview GovCloud","status":"Agency Authorization In Process","phase":"Initial Implementation","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Artificial Intelligence (AI)","Law Enforcement","Research"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"E5BEYXDQYJS6","service_acronym":"Clearview GovCloud","website":"https://www.clearview.ai/gov","sales_email":"fedramp-sales@clearviewai.us","security_email":"fedramp-security@clearviewai.us","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2026-06-30T22:14:49.259Z","cap_date":null,"service_desc":"Clearview GovCloud is delivered as a SaaS offering using a multi-tenant Government-Only Cloud computing environment. It is available to federal, state, local, and tribal governments to investigate crimes, enhance public safety, secure our communities and provide justice to victims.\n \nClearview AI offers  a revolutionary, web-based investigative platform for government agencies to use as a tool to help generate high-quality investigative leads. The user-friendly interface offers advanced administrative tools for oversight, reporting and compliance. To get started, a probe image is uploaded and a required intake form is completed for the agency’s oversight. A vector is created from the probe image and searched against image sources collected from the public internet or agency managed custom galleries. Potential facial image match results are returned with a source URL to the public image. The end user, as part of the human in- the-loop process, verifies and supports returned results with further investigative steps.\n \nClearview AI’s platform searches against a proprietary database of 60+ billion facial images sourced from public-only web sources, including news media, mugshot websites, public social media, and other open sources. Clearview AI’s algorithm is trained on a large, diverse, custom-built dataset of millions of facial images and is tested by NIST, achieving over 99% accuracy across all demographics.","event_log":[{"date":"2026-06-30T22:14:49.259Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"impact_level":{"value":"High","as_of":"2026-07-01","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2026-06-29","as_of":"2026-07-01","source":"old_feed","shown_until":"2026-11-03","label":"Agency In Process status"}},"timeline":[{"date":"2026-06-30","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class D","recorded":"2026-06-30"},{"date":"2026-07-01","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"Clearview AI, Inc."},{"date":"2026-07-01","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"Clearview GovCloud"},{"date":"2026-07-01","kind":"field","source":"old_feed","field":"status","label":"Status","from":null,"to":"Agency In Process"},{"date":"2026-07-01","kind":"field","source":"old_feed","field":"impact_level","label":"Impact level","from":null,"to":"High"},{"date":"2026-07-01","kind":"field","source":"old_feed","field":"cert_path","label":"Path","from":null,"to":"Agency"},{"date":"2026-07-01","kind":"field","source":"old_feed","field":"independent_assessor","label":"Assessor