{"id":"FR1722532017","current":{"csp":"stackArmor","cso":"Clarity","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Emagine IT","partnering_agency":null,"annual_assessment":null,"cert_date":"2019-07-09T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Clarity","website":"https://www.stackarmor.com/solutions/clarity","sales_email":"fedramp-clarity@stackarmor.com","security_email":"fedramp-armory@stackarmor.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137046","status_date":"2019-07-09T04:00:00.000Z","cap_date":null,"service_desc":"Clarity, hosted by stackArmor, offers U.S. government agencies a secure and scalable Strategic Portfolio Management (SPM) solution to make critical decisions with confidence. Part of Broadcom's ValueOps platform and hosted by stackArmor, Clarity allows agencies to customize organizational hierarchies, investment objects, roadmaps and much more in order to run projects and programs their way.\r\n\r\nThe solution provides modern project and portfolio management tools to prioritize requirements, maximize resources, and optimize work with ease.\r\n- One platform. Collect, prioritize, assess, and deliver projects, portfolios, and products, and empower people enterprise-wide, with a single system of record.\r\n- Flexible solution. Manage your entire innovation lifecycle the way you work, including project and portfolio management, demands and resources, and financials and time tracking.\r\n- Persona-based user experience. Modules are specifically designed for project managers, resources managers, and project coordinators to support anything from ad hoc work to complex programs.\r\n- Team collaboration. New tools let team members collaborate within the context of their current work, such as resource or financial management. At the portfolio level, the quality of planning and execution increases significantly when employees can crowdsource ideas and decisions.\r\nClarity is hosted in The Armory by stackArmor which is a dedicated environment for the purpose of delivering software to government customers as a FedRAMP service within Google’s Public Sector Cloud. Clarity is distributed and supported by Carahsoft.","event_log":[{"date":"2017-08-07T04:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2018-05-02T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2019-04-16T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2019-07-09T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"04/16","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2019-07-09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2019-07-09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed"