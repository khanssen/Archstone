{"id":"FR1704655535","current":{"csp":"NICE CXone","cso":"NiCE CXone","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":"2018-04-09T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Communication","Contact Center","Customer Relations Management (CRM)","Customer Service"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"NiCE CXone","website":"http://www.nice.com/","sales_email":"fedrampsolutions@nice.com","security_email":"nicecxonefedramp@nice.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":{"certified":[{"fedRampCertifiedThirdPartyInformationResource":"FR2017257053","useCase":""}],"nonCertified":[]},"independent_assessor_id":"138665","status_date":"2018-04-09T04:00:00.000Z","cap_date":null,"service_desc":"NiCE CXone is a FedRAMP Moderate cloud contact center platform that empowers U.S. federal, state, local, and tribal governments, research institutions, and contractors to deliver modern, secure, and citizen-centric service experiences. By unifying omnichannel engagement, AI, analytics, and workforce optimization, it helps agencies improve responsiveness, efficiency, and trust.\n\n \nKey Capabilities:\n\nUnified Citizen Engagement Platform\nStreamline operations with a single platform that combines advanced routing, centralized administration, and compliant recording. Visual scripting tools reduce IT dependency, enabling faster deployment of IVR and routing flows.\n\nAI-Enhanced Service Delivery\nBoost efficiency and satisfaction with intelligent virtual agents for 24/7 self-service, automated call summaries to reduce after-call work, and real-time agent guidance that improves accuracy and compliance. Automatic Speech Recognition (ASR), text-to-speech and voice biometrics ensure secure, human-like interactions.\n\nSeamless Omnichannel Journeys\nDeliver consistent, context-aware support across voice, email, chat, SMS, and social channels—ensuring citizens don’t have to repeat themselves and agents can act on the full picture.\n\nFrictionless Self-Service\nEmpower constituents to resolve routine needs quickly through multilingual, speech-enabled IVR and automated assistants—while ensuring smooth handoffs to live agents when needed, preserving full context.\n\nProactive Digital Guidance\nReduce website abandonment and improve task completion rates by guiding citizens to the right channels at the right time with rule-based prompts and smart entry points.\n\nOptimized Workforce Performance\nImprove service levels and compliance with AI-driven forecasting, scheduling, and quality management. Personalized dashboards help agents and supervisors stay aligned and accountable.\n\nCompliant, Personalized Outreach\nIncrease engagement and reduce missed appointments with proactive, compliant outbound dialing and digital notifications for reminders, updates, and alerts.\n\nActionable Insights & Compliance at Scale\nLeverage real-time dashboards and speech/text analytics to uncover trends and root causes. Enrich data pipelines for BI/ML initiatives and automate compliance workflows to manage risk effectively.\n\nFlexible Ecosystem Integration\nAccelerate time to value with prebuilt integrations for Microsoft Teams, Salesforce (including Service Cloud Voice), and other leading CRMs. Securely connect to agency databases for smarter, more personalized interactions.\n\nNiCE is globally recognized for its industry compliance and security with robust encryption, advanced threat detection, and continuous monitoring to protect its customers’ sensitive data around the clock.\n\nRecognized as a market leader and trusted by organizations throughout 150+ countries worldwide, NiCE solutions are widely adopted across industries connecting people, systems, and workflows to work smarter at scale, elevating performance across the organization, and delivering proven, measurable outcomes.","event_log":[{"date":"2016-11-17T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2017-08-22T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2018-04-09T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"08/22","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2018-04-09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2018-04-09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"United States Army","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Sponsor"}},"timeline":[{"date":"2016-11-17","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2017-08-22","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","tr