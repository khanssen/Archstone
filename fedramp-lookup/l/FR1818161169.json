d":true},{"id":"FR1807853629A","as_declared":"FR1807853629A","certified":true,"use":"MuleSoft uses CrowdStrike as a centrally managed antivirus protection and endpoint detection and response platform. This service is used to provide system visibility across the environment, anti-virus protection, endpoint detection and response, and security response control during incidents or investigations.","resolved":"id","listed":true},{"id":"FR2120962552","as_declared":"FR2120962552","certified":true,"use":"MuleSoft uses LaunchDarkly for its feature flagging capability. Data sent to and from this service is limited to the custom name of the feature flag, the status of the flag (“on”/”off”), and a Unique User Identifier (UUID). No customer data or critical system data will leave the boundary through this service. The use of LaunchDarkly is dedicated to the MSGov. LaunchDarkly is configured and used in alignment with FedRAMP requirements as described within this SSP.","resolved":"id","listed":true},{"id":"F1603047866","as_declared":"F1603047866","certified":true,"use":"MuleSoft uses AWS GovCloud as its IaaS provider.","resolved":"id","listed":true}],"used_by":[],"hosts":[],"hosted_in":[],"flags":[],"platform_dependents":0},"on_marketplace":true}
