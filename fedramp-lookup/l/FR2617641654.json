{"id":"FR2617641654","current":{"csp":"911inform","cso":"911inform","status":"Agency Authorization In Process","phase":"Initial Implementation","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Fortreum, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Hybrid Cloud","business_categories":["Collaboration","Communication","Law Enforcement"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"W2GGANP2APL9","service_acronym":"911inform","website":"https://911inform.com/","sales_email":"govsales@911inform.com","security_email":"security@911inform.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201664","status_date":"2026-03-27T04:00:00.000Z","cap_date":null,"service_desc":"911inform is a secure, cloud-based emergency response and situational intelligence platform designed for federal and enterprise environments requiring real-time visibility and coordinated response during critical incidents. Delivered within a FedRAMP-aligned SaaS architecture, the platform provides a centralized command-and-control interface for managing emergencies across facilities and agencies.\n\nAt its core is 911inform’s patented Location Discovery Solution (LDS), a Ray Baum’s Act-compliant technology that delivers precise, dynamic location data for 911 calls across PBX, softphone, and mobile devices. The platform enhances emergency response through patented interactive mapping, real-time cellular 9-1-1 call detection with location reporting, and automated multi-channel notifications.\n\n911inform enables secure communications and interoperability between organizations and first responders, delivering real-time situational intelligence to improve coordination and decision-making.\n\nDesigned for scalability and rapid deployment, 911inform integrates with existing telephony, security, and IT infrastructure while maintaining role-based access control, auditability, and secure data handling.\n\n \n\nSERVICES:\n\nRAY BAUM's Act Compliance\n\nKari’s Law Compliance\n\nCellular 9-1-1 Call reporting\n\nInteractive mapping with routing\n\nNotification and messaging services\n\nFirst Responder Coordination\n\nEmergency Location Services","event_log":[{"date":"2026-03-27T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2026-03-27","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Agency In Process status"}},"timeline":[{"date":"2026-03-27","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"911inform"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"911inform"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"status","label":"Status","from":null,"to":"FedRAMP In Process"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"impact_level","label":"Impact level","from":null,"to":"Moderate"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cert_path","label":"Path","from":null,"to":"Agency"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"independent_assessor","label":"Assessor","from":null,"to":"Fortreum, LLC"},{"date":"2026-04-14","kind":"field","source":"o