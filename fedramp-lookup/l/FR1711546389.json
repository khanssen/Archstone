{"id":"FR1711546389","current":{"csp":"Apply Government Solutions","cso":"FedHire","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"SecureIT","partnering_agency":null,"annual_assessment":null,"cert_date":"2022-04-07T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Human Resources"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"URJHSHPGN5Z5","service_acronym":"FedHire","website":"https://www.applygovernmentsolutions.com/","sales_email":"contact@applygovernment.com","security_email":"fedramp@applygovernment.com","trust_center":{"repositoryType":["Trust Center"],"url":"https://community.connect.gov/spaces/FedRAMPExternal/pages/2285367423","repositoryDescription":"Our FedRAMP Package Documentation and Assessment Results are available for review on Connect.gov.","authenticationRequired":true,"accessRequestInstructions":"Customers and prospective customers can request access to our package materials including this document by submitting a Package Access Request form, https://www.fedramp.gov/resources/documents/Agency_Package_Request_Form.pdf, to package-access@fedramp.gov."},"secure_configuration_guidance":{"repositoryType":["Secure Configuration Guidance"],"url":"https://community.connect.gov/download/attachments/2811792065/ApplyGov%20FedHire%20FR%20Rev%205%20Customer%20Security%20Guide_v1.1.pdf","repositoryDescription":"Our Secure Configuration Guide is available via our Trust Center on Connect.gov.","authenticationRequired":true,"accessRequestInstructions":"Customers can request access to our package materials including this document by submitting a Package Access Request form, https://www.fedramp.gov/resources/documents/Agency_Package_Request_Form.pdf, to package-access@fedramp.gov."},"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138819","status_date":"2022-04-07T04:00:00.000Z","cap_date":null,"service_desc":"Apply Government Solutions provides FedHire, the FedRAMP Certified Class C cloud-based talent acquisition platform previously branded as Monster Hiring Management Enterprise (MHME) by Monster Government Solutions. FedHire delivers end-to-end support across the federal hiring and human capital lifecycle, from position classification and vacancy announcement to hiring management and new hire onboarding. As a FedRAMP Certified Class C solution, FedHire is FISMA moderate and built to meet FedRAMP Security Requirements. It meets OMB standards and complies with Section 508 requirements. FedHire is built to integrate across the federal hiring and human capital ecosystem, connecting with systems such as USAJOBS, eOPF, NFC, and IBC - as well as other agency and shared-service platforms - to enable seamless, end-to-end data exchange throughout the hiring lifecycle.<br><br>All components of **FedHire** are certified at the Class C (Moderate) impact level and available to all federal agencies:<br><br>    - **FedHire Hiring Management** is the core applicant tracking system component, integrated with USAJOBS. It supports the creation and posting of job opportunity announcements (JOAs), application management, applicant tracking, candidate referral, and communication among HR staff, hiring managers, and job applicants. It connects to all related FedHire components to support an end-to-end hiring workflow.<br><br>    - **FedHire Position Classification** uses guided builder wizards with intelligent tools for occupational series and grade-level recommendations to develop position descriptions, functional statements, cover sheets, and evaluation statements, and routes documents through review, approval, and storage workflows with version control and status dashboards. It provides a searchable, agency-specific classification library with document comparison and suggestions, and tracks classification data for reporting.<br><br>    - **FedHire Job Analysis** facilitates the collaboration between hiring managers and HR teams to document job-specific competencies and appropriate assessment strategies, and links job analysis results to Job Opportunity Announcements (JOAs), crediting plans, and the position description.<br><br>    - **FedHire Hiring Assessments** provides a framework for delivering external, integrated applicant assessments through third-party assessment providers. The framework is utilized to incorporate standardized, agency-specific, situational-judgment, technical skills, and other assessment methodologies into agency hiring workflows, with assessment results returned to the applicant record to support screening, ranking, and review by HR professionals and hiring managers.<br><br>    - **FedHire Collaborate** creates and assigns subject matter expert (SME) panels to review and score applicants, centralizing vacancy details, scoring parameters, and applicant materials in one location. It collects numerical ratings and narrative feedback from SMEs, averages or consensus-scores candidates, and combines with other assessments into a weighted cumulative score. HR can review, accept, or return SME ratings, and the module documents panel participants, dates, scores, and comments for audit purposes.<br><br>    - **FedHire Selecting Official** provides hiring managers (selecting officials) with tools to review job postings, select assessment criteria, review certificates of eligible applicants, submit annotated certificates to HR, and share certificates across their agency and with other agencies that are granted access.<br><br>    - **FedHire Onboarding / FedHire Onboarding+** (certified 9/25/2025) automates entrance-on-duty processing for new hires, populates onboarding forms from application data, coordinates provisioning across agency departments, and integrates with agency HRIS platforms. Onboarding+ includes and integrates with USAJOBSs’ agency-branded new hire portal and OPM's eOPF. It allows customized agency-branded documents and templates.<br><br>    - **FedHire Analytics** enables review of audit-enabled vacancies and associated documentation for compliance with HR procedures.<br><br>    - **FedHire Auditor** enables review of audit-enabled vacancies and associated documentation for compliance with HR procedures.<br><br>To learn more about the FedHire talent acquisition system (TAS), visit: https://www.applygovernmentsolutions.com/solutions/fedhire/","event_log":[{"date":"2021-05-28T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-04-07T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"05/28","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2022-04-07","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2022-04-07","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2021-05-28","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2022-04-07","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP Certified","track":"Rev5","path":"Agency","class":"Class C","record