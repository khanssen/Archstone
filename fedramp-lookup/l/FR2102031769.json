{"id":"FR2102031769","current":{"csp":"Red Hat, LLC","cso":"Red Hat OpenShift Service on AWS (ROSA)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Coalfire Systems, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2023-08-09T04:00:00.000Z","under_cap":false,"service_model":["PaaS"],"deployment_model":"Government Community Cloud","business_categories":["Development Tools","System Administration","Operations Management","Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"CWGDUMKVDUC4","service_acronym":"ROSA","website":"https://www.redhat.com/en/technologies/cloud-computing/openshift/aws","sales_email":"rosa-govcloud-help@redhat.com","security_email":"fedramp@redhat.com","trust_center":null,"secure_configuration_guidance":{"repositoryType":["Secure Configuration Guidance"],"url":"https://docs.redhat.com/en/documentation/red_hat_openshift_service_on_aws_classic_architecture/4/html-single/getting_started_with_red_hat_openshift_service_on_aws_classic_architecture_in_aws_govcloud/index#rosa-fedramp-security-config","repositoryDescription":"Secure Configuration Guide for Red Hat OpenShift Service on AWS (ROSA) Classic in AWS GovCloud","authenticationRequired":false},"certified_services":[{"serviceName":"Red Hat OpenShift Service on AWS (ROSA) Classic","serviceDescription":"ROSA Classic is a managed OpenShift container platform running on AWS GovCloud, authorized at FedRAMP High. Red Hat SREs handle all infrastructure management, patching, and upgrades, allowing agencies to focus on application workloads rather than platform operations. Agencies can migrate existing on-premises OpenShift workloads to AWS and take advantage of native AWS service integrations while deploying sensitive workloads with confidence in FedRAMP High compliance.","dateAvailable":"2023-08-09"},{"serviceName":"Red Hat OpenShift Service on AWS with Hosted Control Planes","serviceDescription":"ROSA with Hosted Control Planes (HCP) is a deployment model for ROSA in which the OpenShift control plane is hosted and managed in a Red Hat-owned AWS account rather than the customer environment. This architecture reduces infrastructure footprint and costs, enables cluster provisioning in approximately 15 minutes, allows independent upgrades of control plane and worker nodes, and improves security posture by providing clear separation between the management plane and tenant workloads. Red Hat manages the underlying HCP infrastructure, freeing customers from operational overhead while providing a highly available control plane deployed across multiple availability zones.","dateAvailable":"2025-12-08"}],"third_party_information_resources":null,"independent_assessor_id":"138514","status_date":"2023-08-09T04:00:00.000Z","cap_date":null,"service_desc":"Red Hat® OpenShift® Service on AWS (ROSA) is a turnkey application platform jointly managed, operated and supported by Red Hat and AWS. It runs natively on Amazon Web Services (AWS), and allows organizations to increase operational efficiency, refocus on innovation, and quickly build, deploy, and scale applications. Red Hat OpenShift Service on AWS includes fully integrated development and operational productivity features including Kubernetes, an Integrated Development Environment (IDE), build pipelines, monitoring, logging and networking. With 24/7 monitoring and management to ensure seamless operations, organizations can focus on accelerating application delivery, not managing infrastructure. This offering is a FedRAMP High baseline, Platform-as-a-Service (PaaS) cloud service for developing and running containerized applications offered on the FedRAMP authorized AWS GovCloud (US).","event_log":[{"date":"2022-04-12T04:00:00.0