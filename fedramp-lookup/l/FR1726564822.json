{"id":"FR1726564822","current":{"csp":"Workiva","cso":"Workiva Platform","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Fortreum, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2019-10-09T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Workiva Platform","website":"https://www.workiva.com/","sales_email":null,"security_email":"fedramp@workiva.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201664","status_date":"2019-10-09T04:00:00.000Z","cap_date":null,"service_desc":"Workiva provides connected reporting and compliance through its intuitive cloud platform that modernizes how people work within thousands of commercial organizations and hundreds of federal, state, and local government agencies.\n\nWorkiva’s platform is built upon a data management engine, offering controlled collaboration, data integration, granular permissions and a full audit trail. Workiva helps mitigate risk, improves productivity and gives users confidence in their data-driven decisions.\nComplex reports made easy— our customers create and connect data and narrative to consolidate and publish financial, performance, and regulatory reports. We provide confidence in the numbers and enable pride in the delivery.\n\nCompliance made simple— streamline documentation, testing, and reporting in a connected environment. Manage risk assessments, evidence requests, issues, and findings with real-time reports and dashboards.\n\nConnect your documents and data at enterprise scale in a collabora