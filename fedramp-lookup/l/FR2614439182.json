{"id":"FR2614439182","current":{"csp":"Island","cso":"Island Enterprise Platform","status":"Agency Authorization In Process","phase":"Initial Implementation","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Collaboration","Customer Relations Management (CRM)","Customer Service","Cybersecurity & Risk Management","Data Management","Finance","Human Resources","Law Enforcement","Virtual Private Network (VPN)"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"MAC6N2DUZG11","service_acronym":"Island Enterprise Platform","website":"https://www.island.io/","sales_email":"monty@island.io","security_email":"micah.hedges@island.io","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2026-02-24T05:00:00.000Z","cap_date":null,"service_desc":"Island Enterprise Browser is a Government-Community cloud environment that resides in the AWS GovCloud West (Oregon) region. Island leverages the UberEther IAM Advantage (IAMA) PaaS for implementation, management, and monitoring of the AWS GovCloud infrastructure housing Island Enterprise components and inherits FedRAMP High control environments from both AWS and UberEther IAMA.\nIsland Enterprise Browser has been implemented on Amazon Elastic Kubernetes Services (EKS) to provide a microservices-based architecture. The production environment includes applications, operating systems, and AWS FedRAMP-authorized resources and services that support this architecture. The major components include:\nWeb services for access control as well as compute nodes on UberEther-managed instances managed by EKS\nAccess control for customer users to the front end through HTTPS (TLSv1.2 at a minimum)\nAccess control for internal Island Enterprise Browser users to the back end through privileged AWS Identity and Access Management (IAM) user access from AWS Workspaces instances\n\nDatabases/Storage:\nMySQL databases through Amazon Relational Database Service (RDS) as the primary data store  \nAmazon Simple Storage Service (S3) for static content and object storage \nAWS CloudFront for managed caching  \n\nNetworking:\nVirtual Private Cloud (VPC) with public and private subnets \nRoute tables for traffic flow between subnets  \nAWS Firewall and Security groups, acting as virtual firewalls and access control lists \nAmazon EKS and application load balancers (ALBs) \nAmazon Route53 for external and internal DNS \nAWS Certification Manager for public certificates \nAWS Workspaces for remote internal access to the environment \nAWS Internet Gateway and NAT Gateway for access between VPCs \n\nUberEther-Provided AWS Services for monitoring, management, logging, authentication, and support of the system environment and components","event_log":[{"date":"2026-02-24T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2026-02-24","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Agency In Process status"},"partnering_agency":{"value":"Defense Information Systems Agency","as_of":"2026-06-24","source":"old_feed","shown_until":"2026-06-25","label":"Sponsor"}},"timeline":[{"date":"2026-02-24","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agen