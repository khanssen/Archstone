{"id":"FR2210352243","current":{"csp":"SAS Institute, Inc.","cso":"SAS AI and Analytics for Government on FedRAMP","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-01-14T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Hybrid Cloud","business_categories":["Analytics","Data Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"CLXLJLMVK8J5","service_acronym":"SAS AI and Analytics for Government on FedRAMP","website":"https://www.sas.com/en_us/home.html","sales_email":"SASfedramp@sas.com","security_email":"SASfedramp@sas.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2025-01-14T05:00:00.000Z","cap_date":null,"service_desc":"SAS® Viya® provides the foundation for SAS AI and Analytics for Government on FedRAMP, making it possible to integrate teams and technology and deliver significant productivity gains to agencies leveraging data and AI. \r\nWhat’s included in SAS AI and Analytics for Government on FedRAMP:\r\n\r\n•\tSAS Visual Text Analytics \t \r\n•\tStart with training documents to build models iteratively by analyzing and categorizing.  \r\n•\tIdentify and categorize key textual data with interpretive algorithms that incorporate context. \r\n•\tLeverage the best combinations of linguistics, machine learning and natural language processing. \r\n•\tSAS Visual Statistics\t \r\n•\tEnable multiple users to explore data and develop models interactively. \r\n•\tCreate, refine, and test models using in-memory capabilities. \r\n•\tDiscover, predict and act with interactive data exploration and discovery \r\n•\tSAS Viya \r\n•\tCleanse, prepare and manage data for analysis, exploration and feature engineering with modern statistical, data mining and machine learning techniques all in a single, scalable, in-memory processing environment. \r\n•\tUse the comprehensive visual interface to solve complex analytical problems that handles all tasks in the analytics life cycle. \r\n•\tRegister, modify, track, score, publish and report on AI and analytical models. \r\n•\tStore models within folders or projects. \r\n•\tDevelop and validate candidate models and assess candidate models for champion model selection. Then publish and monitor champion models. \r\n•\tSAS Visual Analytics \t \r\n•\tLeverage self-service analytics to make faster decisions with data. \r\n•\tDiscover more relevant relationships in your data. \r\n•\tDevelop dashboards and reports for use and sharing.","event_log":[{"date":"2022-04-26T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2024-11-03T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-01-14T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"05/08","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-01-14","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-01-14","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"val