{"id":"FR2425960757","current":{"csp":"Abnormal AI","cso":"Abnormal AI for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-04-11T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Communication","Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"C1MPKNUNE761","service_acronym":"Abnormal AI for Government","website":"https://abnormal.ai/","sales_email":"govsales@abnormal.ai","security_email":"govsecurity@abnormal.ai","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2025-04-11T04:00:00.000Z","cap_date":null,"service_desc":"Abnormal AI for Government (Abnormal Gov) is a cloud-native, API-based offering that provides holistic email security for cloud email platforms – Microsoft365 and Google Workspace, against the full spectrum of email attacks including advanced phishing, fraud, account compromise, supply chain compromise, user-reporting phishing, and more.\r\nThe platform connects via API to analyze thousands of signals from multiple data sets and precisely baseline known behavior of every employee within an organization and every vendor within the supply chain. Autonomous AI models enable Abnormal Gov to detect anomalous activity and stop never-before-seen attacks quickly and accurately. The platform also serves as an AI Security Co-worker by fully automating the triage and remediation of user-reported emails. AI models judge user-reported emails as safe, spam, or malicious and automatically remediate malicious emails across all affected users using AI, eliminating any manual intervention by security analysts. Additionally, AI models automatically learn the behavioral preferences of every employee through their folder movements of graymail and autonomously declutter inboxes from unwanted mail thereby boosting employee productivity.\r\n\r\nAbnormal Gov’s cloud email security product suite includes Inbound Email Security, Email Account Takeover Protection, AI Security Mailbox, Email Security Posture Management, and Email Productivity. The platform leverages a multi-tenant government cloud computing environment and is available for public, federal, state, local, and tribal governments.","event_log":[{"date":"2024-07-30T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-03-12T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-04-11T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"03/11","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-04-11","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-04-11","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2024-07-30","kind":"status","source":"status_log","from":null,"to":"Agency Authorization I