{"id":"F1210161615","current":{"csp":"Deloitte","cso":"Evidence Management System (EMS)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"MindPoint Group, A Tyto Athene Company","partnering_agency":null,"annual_assessment":null,"cert_date":"2016-03-15T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Hybrid Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Evidence Management System (EMS)","website":"https://www.deloitte.com/","sales_email":null,"security_email":"USGPSBISOISSM@deloitte.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137724","status_date":"2016-03-15T04:00:00.000Z","cap_date":null,"service_desc":"The Deloitte Government and Public Sector Technology Center (GPS TC) provides Software-as-a-Service (SaaS) to government agencies, legal departments, and public entities utilizing machine technology and web services. Deloitte Evidence Management System (EMS) provides advanced technology and experienced staff to assist government agencies responding to requests stemming from litigation, congressional inquiries, FOIA, investigations, and other similar use cases. Our capabilities assist other offerings that need to collect, extract, or analyze unstructured data.\r\n\r\n \r\n\r\nDeloitte EMS draws on years of experience providing government and public sector clients secure eDiscovery solutions and support. Deloitte’s highly skilled technical resources engage a full array of EDRM data management solutions and services that include identifying, preserving, collecting, reviewing, producing, dispositioning, and archiving. Clients who partner with Deloitte can utilize a wide variety of application software in a secure and scalable environment to address their identified mission requirements.\r\n\r\n \r\n\r\n- Disclosure/FOIA (SecureReleaseTM) Advanced Analytics (i.e. active learning, culling data)\r\n\r\n- NavigAite: A Generative AI solution that leverages Relativity, a Large Language Model (LLM) and prompt engineering to summarize, classify, and redact text across extensive document collections\r\n\r\n- SmarText: An OCR solution that leverages LLMs to organize documents, perform data extraction and analysis, and identify redactions for documents integrated with SecureReleaseTM or other document review platforms and tools\r\n\r\n- Information Governance\r\n\r\n- Program Integrity\r\n\r\n- Investigations (i.e., criminal, financial, employment)\r\n\r\n- Data Collection including mobile data/devices, social media, websites, O365 Project and Contract Management Trial Support\r\n\r\n- Customizable and tailored workflows","event_log":[{"date":"2015-12-16T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2015-12-16T05:00:01.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2016-02-12T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2016-03-15T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"01/20","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2016-03-15"