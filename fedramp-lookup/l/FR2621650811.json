{"id":"FR2621650811","current":{"csp":"Consus Industries, Inc.","cso":"Consus Gateway","status":"Legacy FedRAMP Ready","phase":"Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Ignyte Platform Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Artificial Intelligence (AI)","Development Tools"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"MWP8JNZA4BR9","service_acronym":"Consus Gateway","website":"https://consus.io/","sales_email":"sales@consusindustries.co","security_email":"security@consusindustries.co","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201722","status_date":"2026-06-03T22:14:34.918Z","cap_date":null,"service_desc":"Consus Gateway is delivered as a Software as a Service (SaaS) offering using a multi-tenant Government-Only Community Cloud computing environment. It is available to federal contractors and other organizations eligible to consume services hosted in AWS GovCloud (US), GCP Assured Workloads, and Azure Government. The CSO is an OpenAI-compatible AI model routing service: customer applications submit requests to a single API endpoint, and the gateway routes each request to the appropriate large-language-model (LLM) provider hosted within a FedRAMP-authorized cloud environment (AWS Bedrock, GCP Vertex AI, or Azure OpenAI Service). The system is designed with a zero-persistence architecture: prompt and response content are processed entirely in ephemeral AWS Lambda memory and are never written to disk, logged, or stored in any persistent data store. The only persistent records are operational metadata (request identifier, API key identifier, timestamp, model name, token counts, latency, source IP) used for billing, accountability, and continuous monitoring. The intended user base is United States federal agencies and US-person contractor organizations supporting federal missions.","event_log":[{"date":"2026-06-03T22:14:34.918Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"impact_level":{"value":"Moderate","as_of":"2026-06-04","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ready_date":{"value":"2026-06-03","as_of":"2026-06-04","source":"old_feed","shown_until":"2026-11-03","label":"ready_date"},"ready_status":{"value":"2026-06-03","as_of":"2026-06-04","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP Ready status"}},"timeline":[{"date":"2026-06-03","kind":"status","source":"status_log","from":null,"to":"FedRAMP Ready","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-06-03"},{"date":"2026-06-04","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"Consus Industries, Inc."},{"date":"2026-06-04","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"Consus Gateway"},{"date":"2026-06-04","kind":"field","source":"old_feed","field":"status","label":"Status","from":null,"to":"FedRAMP Ready"},{"date":"2026-06-04","kind":"field","source":"old_feed","field":"impact_level","label":"Impact level","from":null,"to":"Moderate"},{"date":"2026-06-04","kind":"field","source":"old_feed","field":"cert_path","label":"Path","from":null,"to":"Agency"},{"date":"2026-06-04","kind":"field","source":"old_feed","field":"independent_assessor","label":"Assessor","from":null,"to":"Ignyte Platform Inc."},{"date":"2026-06-04","kind":"field","source":"old_feed","field":"service_model","label":"Service model","from":null,"to":["SaaS"]},{"date":"2026-06-04","kind":"fiel