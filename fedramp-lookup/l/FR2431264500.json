{"id":"FR2431264500","current":{"csp":"AppOmni","cso":"AppOmni SaaS Security for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-07-02T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Cybersecurity & Risk Management","Network Management","Operations Management","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"AppOmni SaaS Security for Government","website":"https://appomni.com/industry-solutions/public-sector/","sales_email":"support@appomni.com","security_email":"fedramp@appomni.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"AppOmni SaaS Security for Government","serviceDescription":"","dateAvailable":"2025-07-02"}],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2025-07-02T04:00:00.000Z","cap_date":null,"service_desc":"AppOmni SaaS Security for Government is a SaaS security platform designed to protect SaaS applications with posture management, threat detection and response, and identity security capabilities. The AppOmni Platform uses an application programming interface (API) connector to scan customer SaaS instances to discover, protect, and continuously monitor SaaS applications and data. AppOmni can discover misconfigurations that can lead to SaaS data exposures, find out who has access to what data and what might be at risk, and identify unsanctioned third-party applications connected to the SaaS estate. AppOmni can protect data against unauthorized access, apply security best prac