{"id":"FR1821062403","current":{"csp":"Saviynt, Inc.","cso":"Saviynt Enterprise Identity Cloud (EIC)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2019-03-01T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Saviynt Enterprise Identity Cloud (EIC)","website":"https://saviynt.com/","sales_email":null,"security_email":"fedramp@saviynt.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2019-03-01T05:00:00.000Z","cap_date":null,"service_desc":"Saviynt delivers an intelligent and converged platform for Identity Governance and Administration (IGA), Privileged Access Management (PAM) and Cloud Security that enables its customers to effectively manage risk, address continuous compliance needs and securely adopt cloud technologies with confidence. The solution combines advanced analytics with fine-grained privilege management to secure critical data, infrastructure and application assets for Cloud and Enterprise in a unified platform. \n\nSaviynt's completely managed and flexible platform ensures a worry-free adoption of IGA services such as user lifecycle management, access request and certification, Segregation of Duties (SOD) management, infrastructure access governance for IaaS providers (AWS, GCP & Azure), data access governance as well as PAM services. Saviynt's PAM solution is an identity-led service designed for elastic cloud and hybrid IT. It secures privileged access for any application or infrastructure workloads and extends governance to bring-your-own vaults. It is designed to ensure zero standing privileges, provide Just In Time (JIT) access, accelerate rollout at any scale with auto-registration of workloads, and lower the total cost of ownership by eliminating traditional jump boxes.","event_log":[{"date":"2018-04-24T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2018-12-07T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2019-03-01T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"01/28","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2019-03-01","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2019-03-01","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"Centers for Medicare & Medicaid Services","as_of":"2026-06-25","source":"old_feed","shown_until":"2026-11-03","label":"Sponsor"}},"timeline":[{"date":"2018-04-24","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2018-12-07","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process"