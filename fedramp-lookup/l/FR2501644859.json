{"id":"FR2501644859","current":{"csp":"Vibrent Health","cso":"Digital Health Research Platform","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Kompleye","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-06-10T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Content Management System (CMS)","Research"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"WUWGNMBAHKG2","service_acronym":"Digital Health Research Platform","website":"https://researchcloud.vibrenthealth.com/","sales_email":"sales@vibrenthealth.com","security_email":"security@vibrenthealth.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201591","status_date":"2025-06-10T04:00:00.000Z","cap_date":null,"service_desc":"Vibrent Health provides a SaaS Platform that is used by federal and commercial B2B customers to educate, recruit, and engage consumers in a longitudinal, long-term effort to transform the understanding of factors contributing to individual health and disease. The educational component is provided through the Content Management System website for interested prospects to join the program.  Prospects are routed to the Participant Portal when the program is publicly marketed. The content management system (CMS) was chosen to enable content creators and managers throughout the program to easily create and update content for sites designated for each customer. Use cases for DHRP include prevention, control, study, and management of lifestyle and diseases.\nDHRP can also be used to develop applications and websites for volunteers to enroll in the program, provide d