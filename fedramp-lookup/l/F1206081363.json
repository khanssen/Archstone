{"id":"F1206081363","current":{"csp":"IBM","cso":"SmartCloud for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Coalfire Systems, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2019-11-14T05:00:00.000Z","under_cap":false,"service_model":["IaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"SmartCloud for Government","website":"https://www-01.ibm.com/software/lotus/cloud/government/","sales_email":null,"security_email":"ibm.scg.compliance@ibm.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"IBM zCloud Platform as a Service","serviceDescription":"","dateAvailable":"2021-11-08"},{"serviceName":"SCG Distributed Systems Services","serviceDescription":"","dateAvailable":"2024-08-14"}],"third_party_information_resources":null,"independent_assessor_id":"138514","status_date":"2019-11-14T05:00:00.000Z","cap_date":null,"service_desc":"IBM's SmartCloud for Government (SCG) is a secure multi-tenant Infrastructure as a Service (IaaS) cloud computing environment for U.S. Federal customers.\n\nSCG services include provisioning of compute, memory, network, OS, and storage resources to meet client production and development/test computing needs.\n\n\nSCG IaaS services can be bundled with enterprise class, fully managed, cloud hosting services, including:\n\nOS Provisioning and Administration\nEnterprise System Management\nSecurity Operation Center (SOC)\nStorage Management and Backup.\nIBM SCG required services\nStorage management\nFirewall and Network Administration (Boundary management services)\nService Desk\nAccess Management\nCloud Network\nIBM SCG rated services\nSCG Cloud-VM/CPU\nSCG Cloud-Memory\nSCG Cloud-Network\nSCG Load Balancer\nSOC-SOAR\nStandard Endpoint Protection Services\nSystem Vulnerability Scanning\nSecurity Governance and Compliance\n \n\nThese SCG IaaS capabilities can also be leveraged to support a broad range of IBM and 3rd party software offerings using a PaaS or SaaS delivery model.\n\nThe SCG solutions are delivered from IBM Federal Data Centers (FDC) that are expressly designed and managed to meet FISMA requirements.\n\nIBM SCG enables customers to choose cloud solutions and services that meet their workload requirements and helps Government agencies deliver business outcomes with faster time to value and a lower total cost of ownership","event_log":[{"date":"2018-06-19T04:00:00.000Z","category":"Status Change","description":"Status set to FedRAMP In Process","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D"},{"date":"2019-11-14T05:00:00.000Z","category":"Status Change","description":"Status changed from JAB Review to FedRAMP Certified","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"11/14","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2019-11-14","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2019-11-14","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"fedramp_msg":{"value":"IBM SmartCloud for Government was previously authorized by the Joint Authorization Board (JAB). FedRAMP initially provided continuous monitoring oversight;  Continuous monitoring oversight is now provided by active agency customers of this system. If you have any questions regarding this statement, please reach out to us at info@fedramp.gov","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP's listing message"