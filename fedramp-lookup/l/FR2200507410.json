y gates, and code scanning. \n- Continuous deployment and continuous integration, including visual pipeline configuration.\n- Compliance rules for Salesforce metadata, including rule creation, monitoring, and enforcement of policies across user stories, Git snapshots, and deployments. * Test data seeding across sandboxes ensuring accurate quality assurance prior to production deployments.","event_log":[{"date":"2022-02-23T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-10-28T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2023-04-28T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"10/28","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2023-04-28","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2023-04-28","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2022-02-23","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2022-10-28","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2023-04-28","kind":"status","so