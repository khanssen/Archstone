{"id":"FR2029331613","current":{"csp":"Informatica LLC","cso":"Informatica Intelligent Cloud Services (IICS)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2022-02-02T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Informatica Intelligent Cloud Services (IICS)","website":"https://www.informatica.com/solutions/industry-solutions/public-sector.html","sales_email":null,"security_email":"public.sector.compliance@salesforce.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":{"certified":[{"fedRampCertifiedThirdPartyInformationResource":"FR1819057982","useCase":""}],"nonCertified":[]},"independent_assessor_id":"136571","status_date":"2022-02-02T05:00:00.000Z","cap_date":null,"service_desc":"IICS for FedRAMP is a microservices-based, cloud-native data management solution which leverages industry-leading metadata capabilities to accelerate and automate core data management and data governance functions. IICS includes support for both Cloud Data Integration and Cloud Application Integration: \n\nCloud Data Integration \n\nBuilt on a next-generation, microservices-driven software as a service (SaaS), Informatica Cloud Data Integration enables you to connect to industry-leading applications and data sources across on-premises and the cloud and allows you to integrate the data sources at scale. Optimize the performance of your development teams by employing a codeless UI; using drag-and-drop interfaces, and making complex integrations simple. \n\nCloud Application Integration \n\nInformatica Cloud Application Integration (CAI) service offers a single, trusted solution to support any integration pattern, data set, user-type, or endpoint to automate business processes, expedite transactions, and enable real-time analytics. It is based on a modular, microservices-based architecture for agile support of future business requirements. CAI supports multiple new and unique integration patterns, which include on-premises to cloud real-time data integration, real-time/B2B application integration, process orchestration, data synchronization, and more. Users can integrate multi-cloud and hybrid applications without writing a single line of code. \n\nEach of the above services leverages Informatica's Secure Agent, which runs all your Cloud Data Integration and Cloud Application Integration workloads inside the customer’s infrastructure, ensuring the highest levels of security and performance.","event_log":[{"date":"2021-10-08T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2021-10-08T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-02-02T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"10/08","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2022-02-02","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2022-02-02","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP author