{"id":"FR2621733550","current":{"csp":"Wallarm, Inc.","cso":"Wallarm Federal Cloud","status":"Legacy FedRAMP Ready","phase":"Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Fortreum, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Hybrid Cloud","business_categories":["Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Wallarm Federal Cloud","website":"https://wallarm.com/","sales_email":"fedramp-support@wallarm.com","security_email":"fedramp-support@wallarm.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201664","status_date":"2026-05-13T04:00:00.000Z","cap_date":null,"service_desc":"The Wallarm Federal Cloud (WFC) is a Software as a Service (SaaS) application programming interface (API) security platform that provides real-time traffic inspection and Web Application Firewall (WAF) capabilities for federal agencies. It is deployed in a single-tenant, Government-Only Cloud architecture on Google Cloud Platform (GCP).\n\nFunctionality and Use Case:\nThe system is designed to analyze incoming network traffic, mitigate malicious requests, and upload security metrics. The Wallarm Federal Cloud component processes this filtering node data, compiles custom security rules, builds API structure models, and provides the Wallarm Console user interface (UI) for configuration and security event investigation.1\n\nType of Federal Data:\nThe system is categorized at the Moderate security impact level. The federal data and information stored, processed, or transmitted includes:\n- Full HTTP/HTTPS request and response bodies a