{"id":"FR1919071020A","current":{"csp":"SentinelOne","cso":"SentinelOne Singularity Platform High","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2024-09-10T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Cybersecurity & Risk Management","Data Management","Network Management","Operations Management","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"YMGMFUPM1XR9","service_acronym":"SentinelOne Singularity Platform High","website":"https://www.sentinelone.com/","sales_email":"S1-Fed-Sales@sentinelone.com","security_email":"fedramp@sentinelone.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"Cloud Funnel","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Cloud Workload Protection (CWP)","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Digital Forensics & Incident Response (DFIR) services","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Endpoint Detection and Response (EDR)","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Endpoint Protection Platform (EPP)","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Extended Detection and Response (XDR)","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Purple AI Foundations for Public Sector","serviceDescription":"","dateAvailable":"2025-05-14"},{"serviceName":"RemoteOps and RemoteOps Forensics","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Sentinel Agent (Windows, macOS, Linux, and cloud-native Kubernetes)","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"SentinelOne Management Console","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Singularity Cloud Native Security (CNS)","serviceDescription":"","dateAvailable":"2025-08-25"},{"serviceName":"Singularity Data Lake","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Singularity Hyperautomation","serviceDescription":"","dateAvailable":"2025-08-25"},{"serviceName":"Singularity Marketplace","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Singularity Network Discovery","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Singularity Operations Center (OpsCenter)","serviceDescription":"","dateAvailable":"2025-05-14"},{"serviceName":"Singularity Threat Intelligence","serviceDescription":"","dateAvailable":"2025-05-14"},{"serviceName":"Singularity Vulnerability Management","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Vigilance Managed Detection and Response (MDR) services","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"WatchTower and WatchTower Pro Threat Hunting services","serviceDescription":"","dateAvailable":"2024-09-10"},{"serviceName":"Wayfinder Incent Readiness & Response","serviceDescription":"","dateAvailable":"2026-06-05"},{"serviceName":"Wayfinder MDR Elite","serviceDescription":"","dateAvailable":"2026-06-05"},{"serviceName":"Wayfinder MDR Essentials","serviceDescription":"","dateAvailable":"2026-06-05"},{"serviceName":"Wayfinder Threat Hunting","serviceDescription":"","dateAvailable":"2026-06-05"}],"third_party_information_resources":{"certified":[{"fedRampCertifiedThirdPartyInformationResource":"FR2403745080","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2226322745","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2220549818","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2014656304","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"F1303191948","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2430847803","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2322855016","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2002367706","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2213647361","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2025456731","useCase":""}],"nonCertified":[]},"independent_assessor_id":"136571","status_date":"2024-09-10T04:00:00.000Z","cap_date":null,"service_desc":"The SentinelOne Singularity platform is a unified, cloud-delivered security platform that provides customers with automation, endpoint detection and response and security information and event management (SIEM) capabilities integrated with a unified data lake to ingest and centralize structured and unstructured data. SentinelOne leverages advanced machine learning algorithms and behavioral AI to analyze and automatically contextualize endpoint data collected across Windows, macOS, Linux, and Cloud Workloads. Data is contextualized and correlated into our patented Storylines technology, which accelerates triage and reduces mean time to detect/respond. Data is organized into a cohesive threat narrative which allows analysts to easily identify threat-related events as well as pivot and hunt to scope threat tactics, techniques, and impact. This gives our customers the ability to quickly stop ransomware and cyber attacks at machine speed with 1-click automated remediation and rollback of malicious activities and changes. Additionally, SentinelOne offers world-class managed detection and response (MDR), digital forensics and incident response (DFIR), and threat hunting services. Our MDR service not only augments security teams by triaging active or suspicious alerts and mitigating and blocking threats as needed, but also keeps them informed and protected from global advanced persistent threat (APT) campaigns, novel attacker techniques, and emerging trends in cybercrime with included threat hunting services. Customers can also call on SentinelOne’s integrated DFIR team for deeper forensic analysis of an event and assistance with incident response.\r\n\r\nSingularity Cloud Native Security (CNS) is an agentless CNAPP capability for protecting cloud environments and assets. Combined with our agent-based Cloud Workload Security capabilities, agencies have a comprehensive build-time to run-time security solution for their cloud infrastructure. CNS leverages a unique offensive security engine to prioritize vulnerabilities and misconfigurations that are truly exploitable to save time for SOC analysts in triage and investigation efforts CNS includes full capabilities covering CSPM, CIEM, KSPM, IAC Scanning, Secrets Scanning, CDR, and CWP use cases and security requirements.\r\n\r\nSingularity Hyperautomation is a powerful no-code automation solution for streamlining security operations, accelerating threat response, and boosting operational efficiency for security operations teams. Hyperautomation offers analysts the ability to build multi-step automation playbooks taking advantage of unified workflows, pre-built integrations, out-of-the-box templates, and flexible customizations for simplifying delivery of SOAR capabilities from within the unified Singularity platform.\r\n\r\nPurple AI is an agentic-AI powered capability to enable security analysts to detect earlier, respond faster, and stay ahead of modern attacks and threat actors. Integrating innovative LLM, Generative AI, and Natural Language processing technologies, Purple AI is a force multiplier for analysts by reducing manual triage and investigation and, with informed reasoning and decision making, unlocking the ability to take action with human oversight and governance. Purple AI simplifies the complex, amplifies every analyst, and delivers autonomous responses to accelerate security operations.    \r\n\r\nThe following SentinelOne Singularity Platform services are FedRAMP High Authorized:\r\n\r\n-Cloud Funnel\r\n-Cloud Workload Protection (CWP)\r\n-Digital Forensics & Incident Response (DFIR) services\r\n-Endpoint Detection and Response (EDR)\r\n-Endpoint Protection Platform (EPP)\r\n-Extended Detection and Response (XDR)\r\n-Purple AI Foundations for Public Sector\r\n-RemoteOps and RemoteOps Forensics\r\n-SentineOne Agent (Windows, macOS, Linux, and cloud-native Kubernetes)\r\n-SentinelOne Management Console\r\n-Singularity Cloud Native Security (CNS)\r\n-Singularity Data Lake\r\n-Singularity Hyperautomation \r\n-Singularity Marketplace\r\n-Singularity Network Discovery\r\n-Singularity Operations Center (OpsCenter)\r\n-Singularity Threat Intelligence\r\n-Singularity Vulnerability Management\r\n-Vigilance Managed Detection and Response (MDR) services\r\n-WatchTower and WatchTower Pro Threat Hunting services","event_log":[{"date":"2023-04-26T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2023-10-11T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2024-09-10T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"09/30","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2024-09-10","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2024-09-10","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact