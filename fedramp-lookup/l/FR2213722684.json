{"id":"FR2213722684","current":{"csp":"Spider Strategies","cso":"Spider Impact for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"MindPoint Group, A Tyto Athene Company","partnering_agency":null,"annual_assessment":null,"cert_date":"2022-12-13T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Collaboration","Data Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"QNF8NE7JQ2R9","service_acronym":"Spider Impact for Government","website":"https://www.spiderstrategies.com/","sales_email":"government@spiderstrategies.com","security_email":"security@spiderstrategies.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137724","status_date":"2022-12-13T05:00:00.000Z","cap_date":null,"service_desc":"Spider Impact for Government enables cloud-based performance management for defining, measuring, and reporting agency performance against targets and strategic plans. The system is the Federal Government dedicated environment of Spider Strategies’ Spider Impact software. Spider Impact for Government collects, stores, and displays agency key performance indicators (KPIs), generates executive Briefings, Dashboards, and Reports, and enables data analysis and exploration through its business intelligence reporting engine. Spider Impact for Government Scorecards allow agencies to define KPIs and metrics and align them to the overall agency strategy through objectives, initiatives, and corrective action plans. This permits users to track and evaluate their agency’s performance strategically by comparing KPI performance against targets and goals resulting in Red/Amber/Green assessments. Spider Impact for Government Dashboards and Reports allow agencies to create custom, ad-hoc, or cascading dashboards to track and report performance across teams, projects, strategies, or organizations with dynamically updating data collected and reported via Spider Impact for Government scorecards and datasets. The result is reports and dashboards that provide a common operating picture across an agency, based on timely data and insights from agency leaders. Spider Impact for Government Datasets provides users a business intelligence engine to explore and analyze large amounts of data, allowing users to discover insights, trends, correlations, or anomalies within and across agency datasets. Datasets permits agencies to apply conditional and Boolean logic to sort, filter, or report subsets of data. Spider Impact for Government automates data input to save countless hours of data collection, entry, and quality review resulting in greater efficiency in data gathering, greater speed to reporting, and increased return on investment by allowing organizations to devote user time to data analysis and not data collection. Spider Impact for Government, from Spider Strategies, is an approved Software-as-a-Service (SaaS) Performance Management suite for all Federal Government customers, including the Department of Defense at Impact Level 4 (DoD IL4).","event_log":[{"date":"2022-04-12T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-06-07T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-12-13T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Re