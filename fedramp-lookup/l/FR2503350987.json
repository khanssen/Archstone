{"id":"FR2503350987","current":{"csp":"Artera","cso":"Artera Harmony Federal Edition","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2026-05-19T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Communication","Contact Center","Customer Relations Management (CRM)","Health & Wellness"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"L3FECCPGJDV6","service_acronym":"Artera Harmony Federal Edition","website":"https://artera.io/","sales_email":"govsales@artera.io","security_email":"security@artera.io","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2026-05-19T04:00:00.000Z","cap_date":null,"service_desc":"Artera Harmony Federal Edition, powered by its advanced virtual agents, is a comprehensive suite of patient communication tools that transform patient experience through voice, text, and web. Integrating directly into the agency healthcare system's tech stack, including EHRs and third-party vendors, Artera Harmony Federal Edition supports the entire patient journey. The secure platform improves patient engagement by:\n* Automating inbound and outbound communications to streamline critical workflows like pre-visit preparations, post-appointment follow-ups, prescription refills, and ongoing care coordination.\n* Triaging patient inquiries 24/7 and automating administrative tasks, which reduces the burden on front-desk staff and boosts operational efficiency.\n* Providing federal agency personnel with anywhere access to manage conversation workflows, customize communication templates, and oversee all patient communications.\n* Integrating into patients' native phone, SMS/text, and email applications for a truly seamless experience.\n\nIn addition to pursuing FedRAMP High Authorization, Artera’s best-in-class InfoSec approach keeps data safe, compliant and built for healthcare. Artera Harmony Federal Edition, including virtual agents, meets top industry standards – SOC 2 Type 2, HITRUST Certified and is HIPAA compliant. \n\nArtera Harmony Federal Edition is brought to you by Artera Government Solutions, an Artera business unit. Artera is trusted by 900+ provider organizations to engage 100 million patients annually. \n\nLearn more at https://artera.io/federal-healthcare-communication/.","event_log":[{"date":"2025-07-28T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2026-03-05T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2026-05-19T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"03/04","as_of":"2026-05-20","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2026-05-19","as_of":"2026-05-20","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2026-05-19","as_of":"2026-05-20","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_pmo_status":{"value":"2026-03-05","as_of":"2026-04-14","sour