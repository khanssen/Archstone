{"id":"FR2310239588","current":{"csp":"Riverbed Technology","cso":"Riverbed Platform for Government (RP4G)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Coalfire Systems, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2026-05-19T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Cybersecurity & Risk Management","Mobile Device Management (MDM)","Network Management","Operations Management","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Riverbed Platform for Government (RP4G)","website":"https://www.riverbed.com/solutions/platform-for-government/","sales_email":"sales.admin@riverbed.com","security_email":"InfoSec@riverbed.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138514","status_date":"2026-05-19T04:00:00.000Z","cap_date":null,"service_desc":"Riverbed Platform for Government (RP4G) is delivered as a Software as a Service (SaaS) offering within a secure, multi-tenant, government-only cloud environment and is designed to provide visibility into network performance, application behavior, and end-user experience across on-premises, cloud, and hybrid infrastructures.\n\nThe platform integrates network performance monitoring, application observability, and digital experience monitoring capabilities into a unified architecture. The platform specializes in collecting and analyzing telemetry from network devices, applications, endpoints, servers, and cloud resources to support centralized dashboards, reporting, and intelligent analytics. It enables IT op