{"id":"FR2333756970","current":{"csp":"Axiad IDS Inc.","cso":"Axiad Conductor","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-07-17T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"MGKAB33LAQ36","service_acronym":"Axiad Conductor","website":"https://www.axiad.com/axiad-cloud/","sales_email":"info@axiad.com","security_email":"security_officer@axiad.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"Axiad Cloud","serviceDescription":"","dateAvailable":"2023-09-06"}],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2025-07-17T04:00:00.000Z","cap_date":null,"service_desc":"Axiad Conductor is a comprehensive credential management system that secures digital identities across users, machines, assets, and interactions. \r\n\r\n \r\n\r\nAxiad addresses the key requirements in The White House Executive Order (EO) 14028, focusing on phishing-resistant multi-factor authentication (MFA) and Zero Trust. In addition to helping agencies comply with EO 14028 and M-22-09, Axiad is trusted and proven to support the guidance from NIST and CISA.\r\n\r\n \r\n\r\nAxiad Conductor helps customers maximize their investments by seamlessly enhancing existing IAM tools. This approach simplifies the management of disparate IAM solutions in an ever-growing mix of cloud-based, on-prem, air-gapped, and hybrid infrastructures. Axiad Conductor leverages cloud-based PKI and supports the industry’s broadest range of credentials, including x.509-based TLS certificates, FIDO2, mobile MFA, YubiKeys, smart cards from Thales, Idemia and others, TPMs, and biometrics. It can also be applied in heterogeneous IT environments, such as agencies operating Windows, Mac, and Linux operating systems. Axiad Conductor works in any infrastructure or environment, allowing agencies to simplify, scale, and speed up deployments by up to 10 times. This results in lower IT overhead costs, increased user satisfaction, and fortified IAM processes that can withstand modern identity-based attacks.","event_log":[{"date":"2023-09-06T04:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2024-08-08T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-06-11T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-07-17T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"06/11","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-07-17","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-07-17","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"Centers for Disease Control and Preve