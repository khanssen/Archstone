{"id":"FR2624455459","current":{"csp":"Valid8 Financial","cso":"Valid8 Financial GovCloud","status":"Agency Authorization In Process","phase":"Initial Implementation","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Accounting","Analytics","Artificial Intelligence (AI)","Law Enforcement","Legal & Policy"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"J9Q2C6NFLYV5","service_acronym":"Valid8 Financial GovCloud","website":"https://valid8financial.com/","sales_email":"b.polinsky@valid8financial.com","security_email":"support@valid8financial.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2026-06-30T22:14:46.044Z","cap_date":null,"service_desc":"Valid8 Financial GovCloud is a Software-as-a-Service asset tracing and forensic accounting platform hosted in AWS GovCloud (US) within a dedicated FedRAMP authorization boundary. It supports law enforcement, financial investigations, money laundering, elder financial exploitation, healthcare fraud, embezzlement, securities fraud, drug trafficking, human trafficking, gaming, asset tracing, e-discovery, and litigation-support workflows across dozens of states. Agency-controlled evidentiary datasets are ingested into the boundary, stored in encrypted relational and object storage, and processed through the application and analytics layer to organize, trace, and produce financial information for investigative and litigation use.\nThe authorization boundary consists of the ingestion and i