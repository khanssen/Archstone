{"id":"FR2411862686","current":{"csp":"Alation","cso":"Alation Cloud Service","status":"Agency Authorization In Process","phase":"Initial Implementation","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Artificial Intelligence (AI)","Collaboration","Cybersecurity & Risk Management","Data Management","Governance, Risk, and Compliance (GRC)"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"LNKPHZJJFU89","service_acronym":"Alation Cloud Service","website":"https://www.alation.com/","sales_email":"contactsales@alation.com","security_email":"cloud-security@alation.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2026-07-16T04:00:00.000Z","cap_date":null,"service_desc":"Alation Cloud Service (ACS) is delivered as a software as a service (SaaS) offering using a multi-tenant Public Cloud computing environment. It is available to federal, state, local, and tribal government agency customers, federally funded research and development centers (FFRDCs), suppliers working with government agencies, suppliers regulated by regulations such as ITAR, and federal government contractors.\n\nAlation Cloud Service (ACS) is a data and AI management platform that enables organizations to catalog, govern, and operationalize their data assets and AI agents. ACS data layer provides a centralized repository of organizational data that includes Catalog, curated data elements, lineage and data quality. ACS context layer provides business context and semantic definitions on top of cataloged data. This layer includes data products, data products marketplace, and ontologies. ACS Agent layer includes Agent Studio that provides prebuilt agents as well as ability to create custom agents that operate on governed data and context layers. The ACS Governance layer provides policies and workflows to govern data, context and agent layers to support organizational compliance and audit requirements.","event_log":[{"date":"2024-04-26T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-05-27T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2026-07-16T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2026-07-16","as_of":"2026-07-18","source":"old_feed","shown_until":"2026-11-03","label":"Agency In Process status"},"partnering_agency":{"value":"Centers for Medicare & Medicaid Services","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-07-18","label":"Sponsor"},"ready_date":{"value":"2025-05-27","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"ready_date"},"ready_status":{"value":"2025-05-27","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-07-18","label":"FedRAMP Ready status"}},"timeline":[{"date":"2024-04-26","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2025-05-27","kind":