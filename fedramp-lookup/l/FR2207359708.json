{"id":"FR2207359708","current":{"csp":"Evidence Prime","cso":"Laser AI","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B","impact_level":"Unknown","independent_assessor":"Emagine IT","partnering_agency":null,"annual_assessment":null,"cert_date":"2022-08-23T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Laser AI","website":"https://laser.ai/","sales_email":null,"security_email":"fedramp@evidenceprime.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137046","status_date":"2022-08-23T04:00:00.000Z","cap_date":null,"service_desc":"LASER is a system automating the development of Living Systematic Reviews using natural language processing (NLP) and artificial intelligence techniques, which synthesizes available knowledge about a given health problem continuously and with minimal human involvement. As a result, LASER speeds up the process of literature reviews, decreases its costs, and improves the quality of the reviews allowing overworked human specialists to focus on the essential elements offloading much of the repetitive tasks to the AI-enabled system. LASER also provides a human-centric user interface, enabling smooth interaction with suggestions provided by the AI.\n\nLASER supports classical systematic reviews as well as enables quick verification of the quality of the reviews by the regulators and the sponsors, makes it possible to perform a larger number of reviews for personalized medicine or the creation of high-quality rapid assessments in the face of epidemics or ecological disasters.\n\nLASER is built with larger organizations in mind, providing a high level of security as well as enterprise-grade management of projects, teams, roles, shared dictionaries, and customizable workflow processes. LASER helps with the following steps of literature reviews: creation of the review protocol, construction and execution of a search strategy, T&A screening, screening of full texts, data extraction, quality assessment, export of data to meta-analysis tools.","event_log":[{"date":"2022-06-03T04:00:00.000Z","category":"Status Change","description":"Status set to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"},{"date":"2022-06-07T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"},{"date":"2022-08-23T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"}]},"kept":{"annual_assessment":{"value":"06/03","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2022-08-23","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2022-08-23","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"LI-SaaS","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"National Institutes of Health","as_of":"2026-06-25","source":"old_feed","shown_until":"2026-11-03","label":"Sponsor"}},"timeline":[{"date":"2022-06-03","kind":"status","source":"status_log","from":null,"to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class B","recorded":"2026-04-22"},{"date":"2022-06-07","kind":"status","source":"status_log",