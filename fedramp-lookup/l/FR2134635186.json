{"id":"FR2134635186","current":{"csp":"Synack","cso":"On-Demand Security Testing Platform","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2023-12-19T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"EDRWE6PRKL85","service_acronym":"On-Demand Security Testing Platform","website":"https://www.synack.com/platform/fedramp/","sales_email":"fedramp@synack.com","security_email":"fedramp@synack.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"Launchpoint+","serviceDescription":"","dateAvailable":"2023-12-19"},{"serviceName":"Platform Services","serviceDescription":"","dateAvailable":"2023-12-19"},{"serviceName":"Smartscan","serviceDescription":"","dateAvailable":"2023-12-19"}],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2023-12-19T05:00:00.000Z","cap_date":null,"service_desc":"The Synack Platform is a multi-tenant SaaS that delivers continuous security testing, vulnerability management and a managed Vulnerability Disclosure Program (VDP) supported by a network of vetted security researchers. Synack's security testing products include on-demand penetration testing of web, host, cloud, APIs, LLM (AI) and mobile assets – covering both internal and external assets for most federal use cases. \n\nSynack Platform users are able to identify the total amount of vulnerabilities found, get analysis on which are most severe, review stats from testing performed and receive patch efficacy data - providing observability data that can then be correlated with SOC workflows. Synack enables efficient remediation, helping security leaders identify the root cause of vulnerabilities so they can prioritize and eliminate them. Synack combines human and automated test findings with compliance checklists to enhance security posture and provide audit-ready reports that can help meet compliance, including FISMA/NIST 800-53 and BOD 20-01. Synack365, a popular offering on the Synack platform, provides around-the-clock security testing 365 days a year.","event_log":[{"date":"2022-02-04T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2023-01-04T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2023-12-19T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"01/04","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2023-12-19","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2023-12-19","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2022-02-04","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2023-01-04","kind":"status","source":"status_log","from":"Agency A