{"id":"FR2333538201","current":{"csp":"Hypori, Inc.","cso":"Hypori Government Cloud","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Kratos","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-03-20T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Communication"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"TR1XHJJ6N1Q3","service_acronym":"Hypori Government Cloud","website":"https://www.hypori.com/","sales_email":"sales@hypori.com","security_email":"fedramp_compliance@hyporifederal.us","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137255","status_date":"2025-03-20T04:00:00.000Z","cap_date":null,"service_desc":"Hypori Government Cloud provides Virtual Mobility Infrastructure (VMI), a solution that hosts a mobile operating system on a centralized server in a data center that is accessed by thin clients on the user’s end point. Hypori Government Cloud creates a Zero Trust architecture to provide secure access to Controlled Unclassified Information (CUI) and customer data and resources. In the Hypori environment, the user’s device effectively becomes a “window” into a virtualized mobile workspace that is operating in the Amazon GovCloud and delivered via a Software as a Service (SaaS) model. Hypori uses a thin client application to create a virtual image of the user’s unique virtual mobile workspace. The client captures touch and sensor data from the end user physical device and routes it back to the Virtual Workspace through a secure and encrypted TLS tunnel.\r\n\r\nThe Hypori Client has been tested by multiple Red Teams to ensure it meets the most rigorous security posture. It is Common Criteria Certified by the National Information Assurance Partnership (NIAP) for Android, and iOS platforms. NIAP ensures that all certified products “demonstrate exact compliance to the applicable technology protection profile.” This certification verifies that the “Hypori Client is a thin client that communicates only with a Hypori Virtual Workspace on a Hypori Server and not with other servers or applications.” It validates the cryptographic elements of communication with the Hypori environment, that no data is at rest on the user device and no PII is transmitted or stored on the physical end user device. Additionally, the Hypori Client does not trust the mobile device host. It uses application shielding and cryptographic key protection capabilities to defend against compromised end points. It also has limited runtime OS attestation checks before it will launch. If it detects tampering of the client components, it will not connect to the environment. The data on the client is limited to the trust key chain. The mutual Transport Layer Security (TLS) tunnel certificate is stored with the operating system (OS) protected key store on the device, but no other data is on the end user mobile device.\r\n\r\nThe backend environment consists of a series of subnets which form a cluster. Each cluster is designed to support numerous virtual workspace instances. To the user, the experience is virtually identical to when the application and data was on the user’s mobile device. Private keys within the Virtual Workspace are protected using the Android keystore in combination with the Cloud Service Provider key protection system. The Private keys are encrypted in accordance with Hypori’s National Institute of Standards and Technology (NIST) Federal Information Processing Standard (FIPS) 140-2.","event_log":[{"date":"2024-08-30T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2024-08-30T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2025-03-20T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"02/02","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-03-20","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-03-20","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"United States Army","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Sponsor"}},"timeline":[{"date":"2024-08-30","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class D","recorded":"2026-04-22"},{"date":"2024-08-30","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class D","recorded":"2026-04-22"},{"date":"2025-03-20","kind":"status","source":"status_log","from":"FedRAMP In Process","to":"FedRAMP Certified","track":"Rev5","path":"Agency","class":"Class D","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"Hypori, Inc."},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"Hy