{"id":"FR1827963145","current":{"csp":"Exterro, Inc.","cso":"Exterro E-Discovery and Legal Software Platform","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Coalfire Systems, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2021-04-20T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Cybersecurity & Risk Management","Data Management","Law Enforcement","Legal & Policy","Storage"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Exterro E-Discovery and Legal Software Platform","website":"https://www.exterro.com/solutions/government","sales_email":"fedramp_info@exterro.com","security_email":"fedsecurity@exterro.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138514","status_date":"2021-04-20T04:00:00.000Z","cap_date":null,"service_desc":"Exterro offers government agencies a comprehensive platform to manage their diverse needs, from data mapping to incident response, digital forensics, ediscovery and litigation management, and regulatory compliance, including a purpose-built FOIA solution. Exterro understands none of these challenges exist in isolation. Rather, they are interconnected and based in the complex and growing data landscape government agencies must manage. \r\n\r\nExterro solutions can be customized to meet our customers specific requirements, ranging from modular components to address your most pressing concerns to an end-to-end solution encompassing multiple needs. Governments trust Exterro to locate, analyze, and safeguard their data, staying ahead of legal, security, and regulatory risks using our user-friendly, automated, and cost-effective platform.\r\nWith Exterro’s FedRAMP-authorized solutions, federal, state, local, and tribal governments can:\r\n●\tAutomate and Defensibly Manage E-Discovery: Simplify legal hold, collection, processing, review, and production with a single, integrated platform that minimizes risk and reduces costs.\r\n●\tStreamline FOIA & Public Records Requests: Collect, review, redact, and produce responsive information faster while maintaining accuracy, security, and transparency.\r\n●\tEnsure Compliance & Reduce Risk: Maintain a strict chain of custody, leverage in-place preservation, and generate auditable workflows to meet litigation, regulatory, and public disclosure requirements.\r\n●\tLeverage AI with Confidence: Exterro Intelligence accelerates early case assessment, reduces review volumes, and provides accurate, actionable insights.\r\nTrusted across the public sector by government entities and agencies, Exterro software helps them respond faster, reduce costs, and maintain trust by ensuring accuracy, transparency, and defensibility in every process.","event_log":[{"date":"2020-08-14T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2020-08-14T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2021-04-20T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"03/21","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2021-04-20","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":