{"id":"FR2231052341","current":{"csp":"Qualys, Inc.","cso":"Qualys Government Platform","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Coalfire Systems, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-08-14T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Qualys Government Platform","website":"https://www.qualys.com/subscriptions/government/","sales_email":"federal@qualys.com","security_email":"fedramp@qualys.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"CSAM – CyberSecurity Asset Management","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"Certificate View","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"EDR – Endpoint Detection & Response","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"FIM – File Integrity Monitoring","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"GAV – Global Asset View","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"PC – Policy Compliance","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"PM – Patch Management","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"Qflow – Qualys Flow Application","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"TP – Threat Protection","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"TotalAppSec (WAS & API Security)","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"TotalCloud","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"VMDR – Vulnerability Management, Detection & Response","serviceDescription":"","dateAvailable":"2026-03-17"},{"serviceName":"Qualys Enterprise TruRisk Management (ETM)","serviceDescription":"","dateAvailable":"2026-08-04"}],"third_party_information_resources":{"certified":[{"fedRampCertifiedThirdPartyInformationResource":"FR2427142353","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR2311952621","useCase":""}],"nonCertified":[]},"independent_assessor_id":"138514","status_date":"2025-08-14T04:00:00.000Z","cap_date":null,"service_desc":"Qualys Government Platform (QGP) consists of a suite of Information Technology (IT) security and compliance solutions delivered via a SaaS deployment model that leverages a highly scalable multi-tenant cloud infrastructure. The below services are part of the QGP platform - Vulnerability Management, Detection, and Response (VMDR) service enables customers to discover, assess, prioritize, and patch critical vulnerabilities and misconfigurations in near real-time and across your global hybrid-IT landscape all-in-one subscription. Policy Compliance (PC) service provides the ability to run compliance scans and create compliance reports on hosts (IP addresses) that have been added to the Policy Compliance account. File Integrity Monitoring (FIM) service enables monitoring critical files, directories, and registry paths for changes in near real-time, and helps adhere to compliance mandates such as FedRAMP. Container Security (CS) service provides discovery, tracking, and continuously protecting container environments. Addresses vulnerability management for images and containers in their DevOps pipeline and deployments across cloud and on-premises environments. Certificate View (CertView) service provides a comprehensive view of all the SSL/TLS certificates across the enterprise and cloud-hosted assets. CyberSecurity Asset Management (CSAM) service continuously gathers information on all assets, listing systems and hardware details, running services, open ports, installed software and user accounts. Asset discovery and inventory collection is done through a combination of Qualys Sensors, which together can collect comprehensive data from across on-premises or cloud infrastructure as well as remote endpoints. Web Application Scanning (WAS) service enables organisation's to assess, track and remediate web application vulnerabilities to keep their web applications secure. Patch Management (PM) service is used to patch and apply post-patch configuration changes to operating systems, mobile devices, and 3rd-party applications from a large variety of vendors, all from a central dashboard.","event_log":[{"date":"2023-01-19T05:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2025-03-07T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2025-07-31T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2025-08-14T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"07/30","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-08-14","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-08-14","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"High","as_of":"2026-