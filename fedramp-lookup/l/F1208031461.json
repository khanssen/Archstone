{"id":"F1208031461","current":{"csp":"IBM","cso":"IBM Platform Services for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Coalfire Systems, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2015-07-17T04:00:00.000Z","under_cap":false,"service_model":["SaaS","PaaS"],"deployment_model":"Public Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"IBM Platform Services for Government","website":"https://www.ibm.com/products/maas360","sales_email":"SaaS-4Gov-Sales@wwpdl.vnet.ibm.com","security_email":"SaaS-4Gov-SecurityAdmin@wwpdl.vnet.ibm.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"IBM Concert for Government","serviceDescription":"","dateAvailable":"2025-06-04"},{"serviceName":"IBM Instana for Government","serviceDescription":"","dateAvailable":"2025-06-04"},{"serviceName":"IBM MaaS360 for Government","serviceDescription":"","dateAvailable":"2025-06-04"},{"serviceName":"IBM Turbonomic for Government","serviceDescription":"","dateAvailable":"2025-06-04"},{"serviceName":"IBM Verify for Government","serviceDescription":"","dateAvailable":"2025-06-04"}],"third_party_information_resources":{"certified":[{"fedRampCertifiedThirdPartyInformationResource":"FR2524349489","useCase":""},{"fedRampCertifiedThirdPartyInformationResource":"FR1728053006","useCase":""}],"nonCertified":[]},"independent_assessor_id":"138514","status_date":"2015-07-17T04:00:00.000Z","cap_date":null,"service_desc":"IBM Platform Services provides core services for managing devices, applications, content, identity & access management, end-to-end visibility, dynamic resource allocation, and improved operational risk and resiliency. These services work together to modernize device management, IAM, observability, application resource monitoring, and providing clients with AI-driven recommendations and tips that are prioritized and customized for your applications. \r\n\r\nIBM MaaS360 for Government is a comprehensive, cloud-based unified endpoint management and security platform for devices, applications and content built on a secure multi-tenant architecture. Government agencies use MaaS360 to protect data and optimize productivity, enabling employees to work anytime and anywhere through trusted mobile interactions. MaaS360 offers device management and security without the added costs and complexities of deploying hardware and software, dealing with intricate configurations, and dedicating additional resources to support the solution on an ongoing basis. MaaS360 allows administrators to manage and enable security on smartphones, tablets and laptops and increase end users’ productivity by enabling secure access to their enterprise data on their endpoint devices. \r\n\r\nIBM Verify for Government is an Identity-as-a-Service (IDaaS) platform enabling organizations to secure and modernize experiences for workforce and citizens. IBM Verify provides modern Single-sign-on (SSO) using standard protocols (SAML, OIDC, OAuth, etc.), supports legacy protocols and access to thousands of popular cloud service applications, and in-house applications, with hundreds of pre-built templates for faster integration. IBM Verify manages the lifecycle of users and groups through a scalable and elastic directory, provides granular, attribute-based policies, and supports multi-factor authentication. Government agencies can provide a digital first experience for secure and frictionless authentication for citizens. \r\n\r\nIBM Instana for Government is a leading full-stack observability tool that automatically and continuously delivers the highest-fidelity data in one-second granularity, with end-to-end distributed tracing of every call or request, and provides a graphing model with dynamic maps to show you how everything is related. IBM Instana for Government allows you to see the exact data you want in the context you need to quickly determine the cause of an issue and take immediate action to fix it. Government agencies can monitor their entire stack with end-to-end visibility across shared services and gain real-time contextual understanding to find and fix problems faster.\r\n\r\nIBM Turbonomic for Government is the leading Application Resource Management (ARM) solution that dynamically allocates resources in real-time boosting efficiency, minimizing cloud expense, and preventing downtime. IBM Turbonomic for Government delivers continuously optimized application resource performance across hybrid multi-cloud environments providing intelligence automation and proactive resource management that scales existing resources efficiently; preemptive analytics to help maximize resource utilization; dynamic resource allocation; and seamless integration across on premises, public, private, hybrid and multiple cloud domains.\r\n\r\nIBM Concert for Government is the connective tissue that harmonizes data from disparate tools and environments, transforming it into actionable knowledge aimed at improving operational risk and resiliency and freeing up teams to focus more on innovation. IBM Concert for Government provides AI-driven recommendations and tips that are prioritized and customized for your applications. Get automated data analysis from disparate systems and tools, identify operational issues before they escalate, increase efficiency with Concert’s recommendations and automation of repetitive tasks. Government agencies can uncover crucial insights about their operations and get application-specific recommendations for improvement.","event_log":[{"date":"2013-03-07T05:00:00.000Z","category":"Status Change","description":"Status set to FedRAMP In Process","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class C"},{"date":"2015-07-17T04:00:00.000Z","category":"Status Change","description":"Status changed from JAB Review to FedRAMP Certified","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"08/05","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2015-07-17","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2015-07-17","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"fedramp_msg":{"value":"This Cloud Service Offering was previously authorized by the Joint Authorization Board (JAB). FedRAMP initially provided continuous monitoring oversight; however, as of 03/07/2025, continuous monitoring will be provided by active agency customers of this system. If you have any questions regarding this statement, please reach out to us at info@fedramp.gov.","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP's listing message"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2013-03-07","kind":"status","source":"status_log","from":null,"to":"JAB Review","track":"Rev5","path":"JAB","class":"Class C","recorded":"2026-04-22"},{"date":"2015-07-17","kind":"status","source":"status_log","from":"JAB Review","to":"FedRAMP Certified","track":"Rev5","path":"JAB","class":"Class C","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"IBM"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"IBM Platform Services for Government"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"status","label":"Status","from":null,"to":"FedRAMP Authorize