nistration for Citrix services. It enables customers to create, manage, and deploy workspaces—including applications and data—to end users from a single console, while connecting to customer resources across any cloud or infrastructure of their choice. \n\nCitrix DaaS (Desktop as a Service) provides virtualization capabilities that support the management of virtual machines, desktops, applications, and security controls, while enabling users to access resources from any location and on a wide range of devices. This hybrid cloud solution provides secure access to virtual applications, desktops, and data across cloud and on-premises infrastructure.","event_log":[{"date":"2026-03-18T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2026-03-18","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Agency In Process status"},"partnering_agency":{"value":"Defense Logistics Agency","as_of":"2026-06-24","source":"old_feed","shown_until":"2026-06-25","label":"Sponsor"}},"timeline":[{"date":"2026-03-18","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class D","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"Citrix Systems, Inc."},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"Citrix for Government - High"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"status","label":"Status","from":null,"to":"FedRAMP In Process"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"impact_level","label":"Impact level","from":null,"to":"High"},{