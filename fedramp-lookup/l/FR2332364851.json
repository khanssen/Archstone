{"id":"FR2332364851","current":{"csp":"Moveworks","cso":"Moveworks GovCloud","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Fortreum, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2026-01-30T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Collaboration","Communication","Customer Service","Cybersecurity & Risk Management","Data Management","Development Tools","Education & Training","Finance","Health & Wellness"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"NY43SUCE6Y57","service_acronym":"Moveworks GovCloud","website":"https://moveworks.com/","sales_email":"federal-sales@moveworks.com","security_email":"federal-security@moveworks.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201664","status_date":"2026-01-30T05:00:00.000Z","cap_date":null,"service_desc":"Moveworks is the agentic AI assistant platform that empowers every federal employee to get work done with natural language. Trusted by federal agencies to reduce operational complexity, Moveworks unifies siloed business applications—from HR and IT to Finance, Procurement, and beyond—with an intuitive experience that meets employees where they already work, in over 100 languages. Moveworks combines search and action in one platform, eliminating the need for dozens of fragmented AI tools while offering developers the ability to quickly build and deploy custom AI agents tailored to vital federal processes and initiatives.\n\nThe platform is powered by our Reasoning Engine, a sophisticated AI architecture that autonomously and securely understands, plans, executes, and adapts to complete employee requests within your agency’s unique workflows.\n\nDesigned for the unique requirements of the public sector, Moveworks delivers:\n\n* Mission-Ready Security - Moveworks employs rigorous security protocols meeting or exceeding industry standards. We enforce strict measures across the entire product lifecycle to ensure data is always secure.\n\n* Faster Time to Value - Moveworks can be deployed in as little as 8–12 weeks, enabling agencies to realize measurable ROI within days of go-live. With powerful built-in capabilities, agencies unlock immediate value without lengthy customization or complex configuration.\n\n* AI Agility with Agent Studio - Moveworks provides a developer environment allowing builders to easily bring the power of agentic AI to any agency system or process. Every agent built with Agent Studio inherits federal security guardrails, allowing agencies to turn nearly any idea into a conversational use case, securely and at scale.","event_log":[{"date":"2025-01-29T05:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-06-27T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2026-01-05T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2026-01-30T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"12/17","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"20