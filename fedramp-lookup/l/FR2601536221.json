{"id":"FR2601536221","current":{"csp":"Get A-Head","cso":"Get A-Head (Keel Mind)","status":"Legacy FedRAMP Ready","phase":"Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Communication","Content Management System (CMS)","Education & Training","Health & Wellness","Research"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Get A-Head (Keel Mind)","website":"https://www.keelmind.com/","sales_email":"fedrampsales@keel.digital","security_email":"fedrampsecurity@keel.digital","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2025-12-04T05:00:00.000Z","cap_date":null,"service_desc":"The Get A-Head Platform is delivered as a Software-as-a-Service (SaaS) offering using a multi-tenant SAAS cloud computing environment. A cloud-based SaaS platform deployed in AWS GovCloud that enables secure real-time audio communication and content delivery for behavioral health and training use cases. It is available to federal, state, local, and tribal governments, as well as research institutions and federal contractors.\n\nTo simplify the tracking, delivery, and administration of clinical training Get A-Head provides institutions with a digital ecosystem that centralizes and optimizes the interactions between supervisors, counseling trainees, and those seeking mental health support. \n\nDeveloped through the lens of both those seeking and providing mental health care, Get A-Head supports efficient communication between supervisor, trainee, and client, facilitate access to notes, and recorded sessions, across all devices (i.e., smartphones, laptops, desktops, and tablets) in a secure HIPAA & PIPEDA compliant environment.\n\nThe service includes authentication, user access management, secure media distribution, and activity logging through AWS native services, Keycloak, and internal microservices. All components are containerized and orchestrated using AWS services, and encryption is applied end-to-end using FIPS 140-3 validated cryptographic modules. The authorization boundary includes the application services, identity and access management, storage, logging, monitoring, and backup components required to operate the platform in AWS GovCloud.","event_log":[{"date":"2025-12-04T05:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ready_date":{"value":"2025-12-04","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"ready_date"},"ready_status":{"value":"2025-12-04","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP Ready status"}},"timeline":[{"date":"2025-12-04","kind":"status","source":"status_log","from":null,"to":"FedRAMP Ready","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"Get A-Head"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"Get A-Head (Keel Mind)"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"status","label":"Status","from":null,"to":"FedRAMP Ready"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"impact_level","label":"Impac