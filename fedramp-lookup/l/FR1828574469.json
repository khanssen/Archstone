{"id":"FR1828574469","current":{"csp":"FM:Systems","cso":"OpenBlue Employee","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":"2018-10-23T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"OpenBlue Employee","website":"https://fmsystems.com/products/hybrid-workplace/room-scheduling/","sales_email":"FedRAMPsales@fmsgov.com","security_email":"FedRamp@fmsgov.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2018-10-23T04:00:00.000Z","cap_date":null,"service_desc":"OpenBlue Employee, formerly FMS:Employee, offers solutions for organizations with powerful, integrated scheduling features. Built for flexible, collaborative workplaces and designed to increase efficiency and productivity for in-office and remote employees. OpenBlue Employee features desk and resource scheduling, interactive floor plans, contactless workflows, visitor management, and much more. \r\n\r\nRoom & Resource Scheduling - Quickly find and reserve rooms, equipment and services for your remote and in-office employees.\r\n\r\nHoteling & Desk Sharing - Give employees easy access to calendars and reserve spaces with the convenience of mobile scheduling.\r\n\r\nService Management - Streamline complex orders and keep service providers one step ahead of your fast-paced organization with pricing and inventory controls and a dynamic management console.\r\n\r\nInteractive Floor plans - Desk-sharing initiatives are the future of modern workplaces as cloud and mobile technologies offer an ‘anytime, anywhere’ work style.\r\n\r\nOutlook Integration - Make the most of your Outlook calendar by integrating with our room booking and resource scheduling software.\r\n\r\nEvent & Visitor Management - Ensure events and visitors are managed properly from start to finish. Set up new events and capture critical information with a few simple clicks.\r\n\r\nIoT Sensor Integration - Measure actual workspace utilization and identify patterns and trends to build a smarter workspace.\r\n\r\nWorkplace Services & Booking Hardware - Simplify operations and encourage collaboration with streamlined service management and interactive booking hardware.\r\n\r\nReporting & Analytics - Dive into the data and analyze trends by location, person, or department to understand what spaces are underutilized and under-performing.","event_log":[{"date":"2018-07-17T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"},{"date":"2018-10-19T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"},{"date":"2018-10-23T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"}]},"kept":{"annual_assessment":{"value":"11/04","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2018-10-23","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2018-10-23","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"LI-SaaS","as_