{"id":"FR1834348080","current":{"csp":"GDC Integration, Inc.","cso":"General Support System (GSS)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"RISC Point","partnering_agency":null,"annual_assessment":null,"cert_date":"2021-05-10T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"Z7NGCYXV616","service_acronym":"General Support System (GSS)","website":"https://gdcii.com/","sales_email":"sales@gdcii.com","security_email":"fedramp@gdcii.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201825","status_date":"2021-05-10T04:00:00.000Z","cap_date":null,"service_desc":"GDCI provides proven, efficiently priced Federalized SaaS Human Resource\r\nApplications to support the critical human capital functions across the employee\r\nlifecycle.\r\n\r\nTime, Attendance & Leave:\r\nPaycheck 8 reduces the challenging and time consuming effort of tracking and reporting time, attendance, and leave (including VLTP and FLMA). Utilizing agency/department\r\nbusiness rules, Paycheck8 pre-edits to eliminate and reduce time-entry errors, corrected T&A’s and Leave balances. \r\n\r\nLabor and Employee Relations:\r\nLabor-Employee Relations Information System (LERIS) is a state-of-the-art case management and reporting system designed to meet the needs of the labor/employee relations specialist, EEO case manager and other HR specialists, along with agency leadership.\r\n\r\nPerformance Management:\r\nePM is a proven web-based HR system developed to support the effective management, process development, and performance tracking of the appraisal process from start to finish, while maintaining compliance with performance and awards laws.\r\n\r\nOnboarding:\r\neForms is innovative technology designed to improve productivity and eliminate redundant manual data entry for new employee enrollment. It is inclusive of the new hire process and management of enrollment forms and procedures.\r\n\r\nHR Self Service:\r\nConnect HR is an easy to manage HR dashboard designed to leverage the benefits of single sign on, role management, collaboration, communication, business intelligence and document management.\r\n\r\nPersonnel Actions & Awards Tracking:\r\neTracker is a tool developed to easily and efficiently manage, process and track Request for Personnel Action (SF 52), Notification of Personnel Action (SF 50) and Awards Processing.\r\n\r\nUniform Management:\r\nThe Uniform Allowance Management System (UNAW) conveniently provides complete processing, tracking and approval of uniform allowance requests online.\r\n\r\nOrganizational Chart Automation:\r\nFedChart is a workforce planning tool that automates the creation, maintenance, and updating of organizational charts, adhering to agency-specific business rules and\r\nrequirements. Utilizing federal HR data, FedChart visualizes an agency’s organizational structure, positions, and workforce costs.\r\n\r\nHR Data Reporting Automation:\r\nFedLens is a research-based, three module tool designed to enhance data-driven workforce management and planning through automated reports, trend analysis, and predictive analytics. It comprises three modules (Diagnostics, Snapshots, and Predictions) which provide insight based on data benchmarked against standards from the Office of Personnel Management (OPM).\r\n\r\nFEVS Data Reporting Automation:\r\nFedViews is an automated tool for Federal Employee Viewpoint Survey (FEVS) reporting, trend analysis, and workforce planning. It assists federal agencies in generating FEVS reports in compliance with OPM requirements and enables federal HR leaders to compare viewpoint data over time, identify trends, and benchmark scores across departments and within agencies. Action planning modules allow agencies to develop targeted action planning to improve engagement over time.","event_log":[{"date":"2019-02-05T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2020-07-08T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2021-05-10T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"07/30","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2021-05-10","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2021-05-10","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2019-02-05","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2020-07-08","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2021-05-10","kind":"status","source":"status_log","from":"FedRAMP In Process","to":"FedRAMP Certified","track":"Rev5","path":"Agency","class":"Class C","recorde