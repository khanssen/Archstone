{"id":"FR2023864279A","current":{"csp":"Datadog, Inc.","cso":"Datadog for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2026-05-05T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Cybersecurity & Risk Management","Data Management","Development Tools","Network Management","Operations Management","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"L8UFWSCC3JF5","service_acronym":"Datadog for Government","website":"https://www.datadoghq.com/","sales_email":"fed@datadoghq.com","security_email":"fedramp@datadoghq.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2026-05-05T04:00:00.000Z","cap_date":null,"service_desc":"Datadog is an AI-powered observability and security platform that unifies metrics, traces, logs, security signals, and more across your stack into a single pane of glass. Observe any stack at any scale, secure applications from code to cloud, and act faster with automated workflows all in Datadog. Streamline collaboration between Development, Operations, and Security teams with AI-powered insights and automated remediation for faster troubleshooting and improved system health and security.\n\nDatadog for Government extends these capabilities to U.S. government agencies, educational institutions, and the organizations that support them. Hosted on AWS GovCloud, it supports hybrid, multi-cloud, and on-prem environments. Federal, state, and local teams can accelerate IT modernization, strengthen security posture, and support initiatives like Zero Trust and cloud migration—delivering secure, reliable digital services with confidence.\n\nThe services in scope for Datadog for Government are:\n\nInfrastructure Metrics – Observe, analyze, and alert on metrics across hosts, containers, and cloud environments.\n\nCloud Network Monitoring – Provide multi-cloud visibility into network flows in granular detail and enable users to aggregate and monitor that data.\n\nNetwork Device Monitoring – Monitor the health and performance of network devices such as routers, switches, and firewalls.\n\nCloud Cost Management – Analyze and optimize cloud spend with visibility into resource usage and cost drivers.\n\nApplication Performance Monitoring (APM) – Collect, search, and analyze traces across fully distributed architectures.\n\nContinuous Profiler – Continuously analyze code-level performance to identify resource bottlenecks and optimize application efficiency.\n\nServerless Monitoring – Monitor the performance and execution of serverless functions across cloud environments.\n\nDatabase Monitoring – Provide visibility into database performance, query activity, and resource utilization.\n\nLog Management – Collect, enrich, monitor, and analyze logs from all systems for troubleshooting, auditing, visualization, and alerting.\n\nError Tracking – Capture, visualize, and browse errors reported by services.\n\nSensitive Data Scanner – Identify and monitor sensitive data within logs to support compliance and data protection requirements.\n\nAudit Trail – Track user activity and configuration changes for auditing and compliance purposes.\n\nArchive Search – Enable long-term retention and search of log data for compliance and forensic analysis.\n\nCloud Security Monitoring – Enable real time threat detection and investigate security alerts across infrastructure metrics, distributed traces, and logs. This capability encompasses Cloud SIEM, Cloud Workload Security, Cloud Security Platform Monitoring, and Cloud Security Vulnerability Management.\n\nReal User Monitoring (RUM) – Collect user actions (e.g., button clicks) to understand user activity within a page.\n\nSession Replay – Reconstruct user sessions to visually analyze user behavior and troubleshoot issues.\n\nSynthetic Monitoring – Monitor applications and API endpoints via simulated user requests and browser rendering.\n\nIncident Management – Detect, manage, and respond to incidents with workflows for alerting, collaboration, and resolution.\n\nMobile Application – Access the Datadog platform from mobile devices.","event_log":[{"date":"2025-05-07T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2026-05-05T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"04/01","as_of":"2026-05-06","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2026-05-05","as_of":"2026-05-06","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2026-05-05","as_of":"2026-05-06","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2025-05-07","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-05-06","label":"Agency In Process status"}},"timeline":[{"date":"2025-05-07","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class D","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cs