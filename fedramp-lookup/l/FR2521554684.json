{"id":"FR2521554684","current":{"csp":"H2O.AI for Government","cso":"H2O.AI","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Lunarline, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2026-04-16T04:00:00.000Z","under_cap":false,"service_model":["SaaS","PaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Collaboration","Cybersecurity & Risk Management","Data Management","Law Enforcement","Legal & Policy","Network Management","Operations Management","Research","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"H2O.AI","website":"https://h2o.ai/","sales_email":"sales@h2o.ai","security_email":"securitycompliance@projecthosts.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"Enterprise h2oGPTe","serviceDescription":"","dateAvailable":"2025-05-19"},{"serviceName":"H2O AI App Store","serviceDescription":"","dateAvailable":"2025-05-19"},{"serviceName":"H2O Driverless AI","serviceDescription":"","dateAvailable":"2025-05-19"},{"serviceName":"H2O Eval Studio","serviceDescription":"","dateAvailable":"2025-05-19"},{"serviceName":"H2O Hydrogen Torch","serviceDescription":"","dateAvailable":"2025-05-19"},{"serviceName":"H2O LLM Studio","serviceDescription":"","dateAvailable":"2025-05-19"},{"serviceName":"H2O Label Genie","serviceDescription":"","dateAvailable":"2025-05-19"},{"serviceName":"H2O MLOPs","serviceDescription":"","dateAvailable":"2025-05-19"},{"serviceName":"H2O-3","serviceDescription":"","dateAvailable":"2025-05-19"}],"third_party_information_resources":null,"independent_assessor_id":"137004","status_date":"2026-04-16T04:00:00.000Z","cap_date":null,"service_desc":"H2O.ai Cloud for Government (H2O-GOV) is the unified AI platform that delivers the convergence of predictive, generative, agentic, and AI observability & governance for federal agencies. Hosted on AWS GovCloud and fully deployed and managed by H2O.ai, H2O.ai Cloud for Government provides agencies with a secure, mission-ready AI technology stack with dedicated tenancy and full sovereignty over agency data, prompts, and models, without the operational burden of standing up and maintaining the underlying infrastructure. \n\nOverview \n• H2O-GOV accelerates federal AI adoption with a single sovereign AI enterprise-grade control plane, and a platform purpose-built for secure government workloads. This platform reduces the time and resources needed for AI model development, fine-tuning, and evaluation by simplifying workflows; minimizing manual coding and fine-tuning; and automating data preprocessing, including imputation, encoding, standardization, feature engineering, and performance assessment. It also improves the reliability, safety, and effectiveness of RAG and LLM-based applications. Agency data is AI-ready from the start.  The platform is LLM and machine learning model-agnostic, enabling you to connect a wide range of LLMs. It is fully scalable, includes guardrails, summarization, cost controls, telemetry for chargeback, and customization options. \n \n• The platform supports critical federal mission areas, including cybersecurity threat detection, mission analytics, fraud and anomaly detection, predictive maintenance, document triage and extraction, and secure generative AI assistants grounded in agency knowledge. Backed by FedRAMP High authorization, encryption at rest and in transit, dedicated-tenant isolation, and federated SSO integration with agency identity providers, H2O-GOV enables agencies to deploy AI confidently across regulated and sensitive workloads. \n \n• A built-in management layer streamlines user provisioning enforces granular role-based access control (RBAC), and delivers workload and usage monitoring, giving federal program managers the visibility, observability, and governance required to operate AI responsibly at mission scale. H2O.ai's operations team handles provisioning, scaling, patching, software updates, and 24/7 platform support under the FedRAMP-authorized boundary. \n\nPlease note: H2O.ai Cloud for Government is delivered as a product platform. H2O.ai additionally offers professional services and expert guidance to accelerate deployment and, where required, tailored modeling.","event_log":[{"date":"2025-05-06T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2026-03-26T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2026-04-16T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"03/18","as_of":"2026-04-17","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2026-04-16","as_of":"2026-04-17","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2026-04-16","as_of":"2026-04-17","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_pmo_status":{"value":"2026-03-26","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-04-17","label":"PMO In Process status"}},"timeline":[{"date":"2025-05-06","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5"