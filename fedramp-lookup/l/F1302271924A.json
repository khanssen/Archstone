{"id":"F1302271924A","current":{"csp":"BlackBerry","cso":"BlackBerry Cloud - AtHoc Services for Government (High)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Kratos","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-04-11T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Hybrid Cloud","business_categories":["Collaboration","Communication","Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"BlackBerry Cloud - AtHoc Services for Government (High)","website":"https://www.blackberry.com/en/secure-communications/athoc","sales_email":"cstrain@blackberry.com","security_email":"securitycertifications@blackberry.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137255","status_date":"2025-04-11T04:00:00.000Z","cap_date":null,"service_desc":"BlackBerry's AtHoc is a networked crisis communication platform enabling corporations and government agencies to communicate and collaborate securely with their personnel and with other organizations through multiple devices during times of crises. BlackBerry's AtHoc platform addresses critical communications needs including: Account: AtHoc Account enables real-time visibility into location and status for effective personnel accountability and crisis handling before, during, and after emergencies. This integrated approach to personnel accountability enables inputs from managers about their team, call center operators, data streams from HR and travel systems, as well as self-reporting by individuals. Alert: AtHoc Alert provides a comprehensive crisis communication solution that unifies all channels and devices, empowering organizations, people, and communities to collaborate during critical events. AtHoc's flexible deployment options safeguards important personal information and enables enterprise-level command and control. Connect: AtHoc Connect empowers organizations to create their own permission-based network to establish interoperable communication and information sharing with organizations in their community. Collect: AtHoc Collect empowers your personnel in the field to be the \"eyes and ears\" of the operations center. AtHoc Collect enables on-scene personnel to report events, work progress, along with rich geo-tagged media that are worth a thousand words.","event_log":[{"date":"2024-10-29T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2024-10-29T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2025-04-11T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"04/30","as_of":"2026-06-25","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-04-11","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-04-11","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"Federal Aviation Administration","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label