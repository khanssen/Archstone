{"id":"FR2213764335","current":{"csp":"Noblis","cso":"RunCyberAssurance","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Lunarline, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2023-08-31T04:00:00.000Z","under_cap":false,"service_model":["SaaS","PaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Cybersecurity & Risk Management","Data Management","Operations Management","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"RunCyberAssurance","website":"https://www.noblis.org/","sales_email":"answers@noblis.org","security_email":"answers@noblis.org","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137004","status_date":"2023-08-31T04:00:00.000Z","cap_date":null,"service_desc":"Noblis’ RunCyberAssurance® is a comprehensive, automated solution that advances the efficacy of Continuous Monitoring programs. The Noblis RunCyberAssurance solution enables agencies and their Cloud Service Providers to gain a fast, accurate view into their vulnerabilities, manage Plan of Action and Milestones (POA&Ms) and deviation requests and improve visibility into the security posture of complex information systems. RunCyberAssurance frees cybersecurity professionals from mundane manual tasks, allowing them to focus on high-value threat assessment activities. The solution accepts data feeds “as is” from over 40 industry standard vulnerability scanning tools and generates reports and outputs in FedRAMP and Open Security Controls Assessment Language (OSCAL) formats.   \n\nNoblis’ RunCyberAssurance is powered by our EDGE@AWS Platform-as-a-Service (PaaS) and leverages the Community AWS GovGloud Infrastructure-as-a-Service. In addition, it leverages AWS US East/West, Okta ID-as-a-Service and ServiceNow. The Noblis EDGE@AWS PaaS provides a FedRAMP Moderate compliant platform for Noblis applications and systems.","event_log":[{"date":"2022-09-28T04:00:00.000Z","category":"Status Change","description":"Status set to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-10-05T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2023-08-31T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"09/28","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2023-08-31","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2023-08-31","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2022-09-28","kind":"status","source":"status_log","from":null,"to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2022-10-05","kind":"status","source":"status_log","from":"FedRAMP In Process","to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2023-08-31","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP Certified","track":"Rev5","path":"Agency","class":"Class C","recorded"