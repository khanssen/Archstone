{"id":"FR2532766956","current":{"csp":"IntelliGRC, Inc.","cso":"IntelliGRC","status":"Legacy FedRAMP Ready","phase":"Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Cybersecurity & Risk Management","Governance, Risk, and Compliance (GRC)"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"IntelliGRC","website":"https://intelligrc.com/","sales_email":"Sales@intelligrc.com","security_email":"FedRAMP@intelligrc.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2025-12-04T05:00:00.000Z","cap_date":null,"service_desc":"IntelliGRC is an AI-powered, all US-based and developed FedRAMP-aligned multi-tenant Governance, Risk, and Compliance (GRC) SaaS platform purpose-built for Service Providers (MSPs/MSSPs), cybersecurity consultants, and regulated organizations that must achieve, manage and maintain audit-ready compliance at scale. The platform combines asset-centric scoping, context-aware control mapping, intelligent automation, bidirectional cross tenant shared implementations, and practitioner-trained AI features to streamline assessments, evidence collection, ongoing monitoring, and compliance program management across multiple frameworks. \n\nDesigned with deep operational expertise from cybersecurity assessors and compliance practitioners, IntelliGRC enables service providers to deliver consistent, repeatable, and high-caliber compliance outcomes for their customers while reducing manual effort an