{"id":"FR2425374322","current":{"csp":"BP Pulse","cso":"Omega Charge Management System","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-05-06T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Fleet Management","Operations Management","Travel Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Omega Charge Management System","website":"https://bppulsefleet.com/fleet/products/charge-management-software/","sales_email":"hellobppulse@bp.com","security_email":"support@bppulsefleet.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2025-05-06T04:00:00.000Z","cap_date":null,"service_desc":"Omega Charge Management software (CMS) automatically schedules EV charging during times when energy costs are lower while accounting for operational requirements. It comes with 99.9% platform uptime to help keep fleet operations running smoothly. This means fleet operators can spend less time managing charging while reducing energy costs. \n \nOmega provides complete visibility of EV fleet charging operations and sends real-time critical alerts all from one dashboard, maximizing vehicle uptime. Omega can also integrate with any vehicle, EVSE, telematics, or fleet management tool, so operators can use what works best for their fleet now and in future. This includes chargers from all major OEMs using Open Charge Point Protocol (OCPP) v1.6x. \n \nOur experts can also guide fleets through the electrification journey, from site design and charger installation to ongoing operations and maintenance. This includes a range of EV charging stations to suit specific fleet needs. Fleets can also pair this with our Charging-as-a-Service (CaaS) model to bundle CapEx costs into one monthly Opex, reducing upfront investment and making it easier to manage costs long-term.​","event_log":[{"date":"2024-07-03T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"},{"date":"2025-03-20T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"},{"date":"2025-05-06T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class B"}]},"kept":{"annual_assessment":{"value":"03/11","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-05-06","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-05-06","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"LI-SaaS","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2024-07-03","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class B","recorded":"2026-04-22"},{"date":"2025-03-20","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class B","recorded":"2026-04-22"},{"date":"2025-05-06","kind":"status","source"