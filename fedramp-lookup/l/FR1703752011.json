{"id":"FR1703752011","current":{"csp":"Axon","cso":"US Axon FedCloud - High","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Fortreum, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2022-11-22T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Data Management","Law Enforcement"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"TBW7MGPYURM7","service_acronym":"US Axon FedCloud - High","website":"https://www.axon.com/","sales_email":null,"security_email":"fedsec@axon.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201664","status_date":"2022-11-22T05:00:00.000Z","cap_date":null,"service_desc":"US Axon FedCloud enables cloud-based workflows for digital evidence management, situational awareness, and records management to support the operational needs of agencies. The system operates as an isolated region of Axon Cloud Services that is dedicated to the US Federal community. US Axon FedCloud offerings include Axon Evidence, Axon Respond, and Axon Records while also acting as the core control center over Axon devices and client applications. These devices and client applications include in-car camera systems, body-worn cameras, TASER devices, Axon Interview Room, and Axon Upload XT.\n\nAxon Evidence acts as a central repository for customers' digital evidence and a central management console for Axon products and devices. With expansive ingest, smooth playback, and intuitive search, Axon Evidence makes it simple to connect and manage growing stores of data—video, photos, documents and more—in a single, secure system.\n\nAxon Respond is a real-time operations platform which integrates real-time situational awareness and unified communications within a modern incident management solution. Gathering data from sensors in the field, agencies are empowered to know when events occur before it's voiced through traditional contact methods and rapidly coordinate responses with a unified communications platform.\n\nAxon Records harnesses the power of automation to save countless hours in the report writing, submission, and review process, helping agencies get more efficiency by breaking down data silos. With direct access to body-worn camera, in-car and citizen-captured video footage, documents, images, and more, reports can be created faster. Critical evidence can be easily shared to remove the wall between digital evidence and reports.","event_log":[{"date":"2022-02-24T05:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D"},{"date":"2022-04-02T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to FedRAMP In Process","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D"},{"date":"2022-11-22T05:00:00.000Z","category":"Status Change","description":"Status changed from JAB Review to FedRAMP Certified","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"04/02","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2022-11-22","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2022-11-22","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"fedramp_msg":{"value":"US Axon FedCloud - High previously became FedRAMP-Authorized by the Joint Authorization Board (JAB).","as_of":"2026-06-25","source":"old_feed","shown_until"