{"id":"FR2619446518","current":{"csp":"Moodle US LLC","cso":"Moodle for Government","status":"Legacy FedRAMP Ready","phase":"Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Collaboration","Communication","Content Management System (CMS)","Data Management","Design & Multimedia","Development Tools","Education & Training","Human Resources"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Moodle for Government","website":"https://moodle.com/us/solutions/government/","sales_email":"jim.mezzanotte@moodle.com","security_email":"maxine.henry@moodle.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2026-04-23T04:00:00.000Z","cap_date":null,"service_desc":"Moodle for Government is a FedRAMP® Ready SaaS Learning Management System (LMS) powered by Moodle Workplace, specifically engineered to meet the mission-critical training and compliance requirements of U.S. public sector agencies including federal, state, and local. Built on a foundation of \"security by design,\" Moodle for Government provides a secure, scalable, and highly customizable environment for mandatory compliance training, workforce development, onboarding, and large-scale government training initiatives that evolves with your agency.\nAs our dedicated public sector solution built around Moodle’s enterprise learning platform, Moodle for Government enables agencies to modernize their learning ecosystems while maintaining the highest standards of control and accountability. This solution includes a wide variety of additional plugins to extend enterprise capabilities even further, and it is deployed in AWS GovCloud through our own proprietary hosting tool, which orchestrates our curated set of infrastructure components. Our solution is designed to optimize performance, reliability, and security while also offering a high level of autonomy, with dedicated per-client resources and client control of major-release upgrade scheduling.\nMoodle for Government is committed to accessibility and meeting federal mandates. The platform is 508 and WCAG 2.2 AA compliant and supports over 20 languages, ensuring all personnel can access training regardless of location or ability. In addition to its FedRAMP Ready status, Moodle services in the U.S. are SOC 2 Type 2 compliant.\nWith robust functionality, Moodle for Government empowers teams to:\n-Utilize rule-based automation to track certifications, manage renewals, and generate audit-ready reports.\n-Deliver role-based learning paths tailored to specific job functions or mission requirements.\n-Gain real-time visibility into training progress and skills gaps through customizable reporting dashboards.","event_log":[{"date":"2026-04-23T04:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"impact_level":{"value":"Moderate","as_of":"2026-05-02","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ready_date":{"value":"2026-04-23","as_of":"2026-05-02","source":"old_feed","shown_until":"2026-11-03","label":"ready_date"},"ready_status":{"value":"2026-04-23","as_of":"2026-05-02","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP Ready status"}},"timeline":[{"date":"2026-04-23","kind":"status","source":"status_log","from":null,"to":"FedRAMP Ready","track":"Rev5","path":"Agency","class":"Class C","recorded":"2