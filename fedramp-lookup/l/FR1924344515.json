{"id":"FR1924344515","current":{"csp":"Wellspring Worldwide, Inc.","cso":"Wellspring Tech Transfer and IP Management Suite (WTIMS)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Lunarline, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2022-02-14T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Wellspring Tech Transfer and IP Management Suite (WTIMS)","website":"https://www.wellspring.com/","sales_email":"rich.barndt@wellspring.com","security_email":"securitycompliance@projecthosts.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137004","status_date":"2022-02-14T05:00:00.000Z","cap_date":null,"service_desc":"The Wellspring Tech Transfer and IP Management Suite is delivered as a SaaS offering using a multi-tenant Government Community cloud computing environment. It is available to federal, state, local, and tribal governments, as well as research institutions, federal contractors, government contractors.\n\nWellspring Sophia is a browser based application used to manage all of the initiatives and activities required in the technology transfer field. Sophia provides over 30 modules, plug-ins, and integrations that include IP management, contract management, reporting, disclosure and project submissions, and more. With more than 15 years in the tech transfer industry and more than 250 institutions using our solutions, Wellspring provides the most complete technology transfer management software available with unparalleled functionality, flexibility, and support staff to professionals in the technology transfer field worldwide.\n\nEvolve is Wellspring's next-generation software platform that streamlines technology transfer and IP management from invention disclosure through licensing and commercialization, with intuitive workflows, and seamless data integrations. The Evolve application runs inside Salesforce Gov Cloud and relies on Sophia hosted services for capabilities that extend beyond native Salesforce functionality along with functionality to migrate Sophia users to evolve to leverage more modernized components.\n\nAll four components are hosted within the FedRAMP environment and communicate with Salesforce Gov Cloud over HTTPS and provided the following functionality:\n\n- Evolve DocGen: Generates PDFs from Salesforce record data and document templates\n- Evolve DocSign: Manages electronic signature workflows with a signer-facing hosted UI\n- Evolve iEdison API: Pushes invention disclosure, patent, and utilization data from Salesforce to the NIST iEdison API\n- Evolve Migration Worker: Prefect-based worker that authenticates directly to Salesforce Gov Cloud and performs bulk data loads, file operations, and schema changes during the Sophia-to-Evolve migration.","event_log":[{"date":"2021-03-04T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2021-03-04T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-02-14T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"03/04","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annu