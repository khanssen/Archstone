{"id":"FR2023666173","current":{"csp":"Scale AI, Inc","cso":"Scale AI Data Platform","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2024-09-09T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Cybersecurity & Risk Management","Data Management","Development Tools","Law Enforcement","Research"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"HU2LMKSDQD9","service_acronym":"Scale AI Data Platform","website":"https://scale.com/federal","sales_email":"fedramp@scale.com","security_email":"security@scale.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"Data Engine","serviceDescription":"","dateAvailable":"2024-09-09"},{"serviceName":"Donovan","serviceDescription":"","dateAvailable":"2024-09-09"},{"serviceName":"Scale Generative AI Platform","serviceDescription":"","dateAvailable":"2024-09-09"}],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2024-09-09T04:00:00.000Z","cap_date":null,"service_desc":"The ScaleGov mission is to accelerate the development and deployment of artificial intelligence (AI) solutions within the government space. Scale's comprehensive AI Data Platform goes beyond data labeling, now offering a fully-managed, API-driven solution for the test, evaluation, and development of AI-enabled enterprise applications. This includes Scale's Generative AI Platform (SGP), which empowers organizations to rapidly iterate and scale their AI models across various use cases with robust tooling for enterprise-level testing, evaluation, and operationalization.\r\n\r\nIn addition, Scale's platform now integrates Donovan, a powerful enterprise chat solution built on SGP. Donovan provides real-time, AI-driven insights and collaboration capabilities, augmenting human workflows with intelligent assistance and context-aware responses to enhance decision-making and productivity.\r\n\r\nScale continues to offer best-in-class tools and processes for creating high volumes of training data. The managed labeler network uses automated quality assurance, training, matching, and incentive systems to accurately label more than one hundred million annotations monthly. Scale's advanced quality pipeline incorporates active tooling and pre-labeling techniques, driving worker efficiency and accelerating customer workflows. Through Scale's customer management platform, clients can receive data in real-time, monitor task progress, audit results, and provide feedback across a broader range of AI-driven initiatives.","event_log":[{"date":"2022-09-08T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2023-05-10T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2024-09-09T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"01/26","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2024-09-09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2024-09-09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact