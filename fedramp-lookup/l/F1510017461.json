{"id":"F1510017461","current":{"csp":"Unison","cso":"FedConnect","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Kratos","partnering_agency":null,"annual_assessment":null,"cert_date":"2016-10-19T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"FedConnect","website":"https://www.unisonglobal.com/","sales_email":null,"security_email":"fedramp@unisonglobal.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137255","status_date":"2016-10-19T04:00:00.000Z","cap_date":null,"service_desc":"FedConnect provides US Government Acquisition leaders and Contract Officers a secure, full-lifecycle, auditable approach to interacting with vendors and complying with Paperless Contracting mandates. FedConnect is a Federal acquisition and grants portal where vendors and grant applicants can find opportunities for federal contracts, grants, and other types of assistance funding. It was developed to bridge the gap between government agencies and their vendor and grant applicant/recipient communities in order to streamline the process of doing business with government. \n\nThrough the FedConnect portal, Federal Government representatives are able to issue opportunity requests and make awards via the internet. Company representatives are able to review opportunities, submit bids or proposals, and receive awards. FedConnect provides an open channel of communication with the government that is both secure and auditable.\n\nThere are three types of government opportunities facilitated through FedConnect: traditional eRFX issuance, Reverse Auction events, and Financial Assistance opportunities, e.g. grants. For eRFX and Financial Assistance opportunities, FedConnect is offered by subscription fee to Federal Government agencies that are federally regulated. For Reverse Auction only, there is no subscription fee to Federal Government agencies. The bidding and winning vendor company is responsible for payment upon award.\n\nOn the government side, FedConnect is accessed through a system-to-system interface to the Unison Contracting and Grants software applications, where Government procurement and grant representatives become indirect users of FedConnect.\n\nOn the Vendor/Applicant side, FedConnect is accessed via the internet with a browser. Anyone can access the FedConnect web site and review public opportunities. However, to receive directed opportunities that are not publicly issued, respond electronically, and receive ongoing communications, a vendor/applicant must be registered.\n\nTo learn more about FedConnect and its capabilities, please visit the public portion of the FedConnect site.","event_log":[{"date":"2015-10-20T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2016-05-18T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2016-10-19T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"05/24","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2016-10-19","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Au