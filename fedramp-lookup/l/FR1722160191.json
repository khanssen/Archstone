 and driver logic\r\n\r\n·         Auto-generated documents, briefings, and charts with traceable sources\r\n\r\n·         Conversational access to complex decision structures — no dashboards required\r\n\r\n·         Fully compliant with DoD IL5 and FedRAMP High standards\r\n\r\n·         Embedded agents for data validation, workflow automation, SmartBoard execution, and more\r\n\r\nBuilt for structure, not just search. CORAS reasons over driver trees, KPIs, and operational dependencies — making it the go-to platform for decision intelligence in federal environments.","event_log":[{"date":"2020-11-05T05:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D"},{"date":"2021-02-04T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to FedRAMP In Process","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D"},{"date":"2021-07-27T04:00:00.000Z","category":"Status Change","description":"Status changed from JAB Review to FedRAMP Certified","cert_type":"Rev5","cert_path":"JAB","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"07/23","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2021-07-27","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2021-07-27","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"fedramp_msg":{"value":"CORAS Federal previously became FedRAMP-Authorized by the Joint Authorization Board (JAB).","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP's listing message"},"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ready_date":{"value":"2020-11-05","as_of":"2026-04-14","source":"old_feed","shown_