{"id":"FR2524416446","current":{"csp":"Orbus Software","cso":"OrbusInfinity Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Lunarline, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2026-01-20T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Collaboration","Communication","Cybersecurity & Risk Management","Data Management","Fleet Management","Network Management","Operations Management","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"OrbusInfinity Government","website":"https://www.orbussoftware.com/product/orbusinfinity-federal","sales_email":"sales@orbussoftware.com","security_email":"securitycompliance@projecthosts.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137004","status_date":"2026-01-20T05:00:00.000Z","cap_date":null,"service_desc":"OrbusInfinity Government is a Software as a Service (SaaS) solution hosted in Azure, offering multi-tenant environments for US government agencies. OrbusInfinity integrates with your Commercial or GCC Microsoft 365 environment. Meeting FedRAMP Moderate security standards, OrbusInfinity Government ensures data security and sovereignty. \n\nOrbusInfinity Government provides secure SaaS capabilities that enable federal agencies to optimize technology investments, create AI-driven value, drive effective business transformation, accelerate innovation, and strengthen resilience and compliance.\nWith OrbusInfinity Government, federal agencies can modernize IT systems, improve citizen services, and deliver cost savings. Teams can collaborate seamlessly across enterprise architecture and project delivery domains and leverage capabilities to realize a wide range of use cases within a secure, compliant platform. Transformation insights can be shared on demand from the central repository to stakeholders via personalized dashboards, to guide successful transformation outcomes. \n\nOrbusInfinity Government enables federal agencies to: \nOptimize Delivery of Public Services: Design streamlined citizen-centric digital services, improving accessibility, visibility, and public trust. \n\nAccelerate Technology Modernization Initiatives: Generate the blueprint for cloud migration, legacy system replacement, and adoption of new technologies, reducing risk and ensuring alignment with agency goals. \n\nSupport Budget Accountability and Investment Planning: Provide clear visibility into IT assets and initiatives to track spending, prioritize investments, and deliver measurable cost savings, driving transparent accountability reporting including OBR. \n\nOptimize Mission Areas: Align technology and resources with core mission areas, providing a holistic view of how capabilities, applications, people, and processes work together to deliver services, enabling agencies to continuously improve and optimize critical functions. \n\nOptimize Government Resources and Reduce Costs: Identify redundant systems, streamline IT portfolios, and make smarter investments. \n\nStrengthen Cybersecurity and Compliance: Align systems and processes with federal security standards (such as FISMA, FedRAMP, NIST), reducing vulnerabilities and audit risk. \n\nEnable Real-Time Insights and Data-Driven Decisions: Utilize a single source of truth to act on real-time insights, manage risk, and respond more effectively to emerging priorities. \n\nEnhance Collaboration and Break Down Silos: Foster better communication and coordination across departments, programs, and between agencies, supporting cross-government initiatives. \n\nIncrease Accountability and Transparency: Map processes, data, and systems, to gain clear oversight and demonstrate compliance with laws, regulations, and policy mandates.","event_log":[{"date":"2025-06-04T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2026-01-05T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2026-01-20T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"12/31","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2026-01-20","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2026-01-20","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2025-06-04","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-01-05","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-01-20","kind":"status","source":"status_log","from":"FedRAMP In Process","to":"FedRAMP Certified","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","fi