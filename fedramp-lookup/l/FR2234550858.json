{"id":"FR2234550858","current":{"csp":"Concur Technologies, Inc.","cso":"Concur Cloud for Public Sector","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2024-01-17T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Accounting","Finance","Travel Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"WYWDHGHWCQ54","service_acronym":"Concur Cloud for Public Sector","website":"https://www.concur.com/","sales_email":"tony.rollins@sap.com","security_email":"SAP_Concur_CCPS_FedRAMP_Security_Inbox@sap.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"Advanced Care","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Budget","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Central Reconciliation","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Client Web Services","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Company Bill Statements","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Concur Expense only","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Concur Request","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Concur Travel & Expense","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Concur Travel and Expense","serviceDescription":"","dateAvailable":"2024-01-19"},{"serviceName":"Concur Travel only (Direct/Indirect)","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"ConcurGov","serviceDescription":"","dateAvailable":"2024-01-19"},{"serviceName":"Consultative Intelligence","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Custom Connector - Expense","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Detect by Oversight","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Essential Care","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"ExpenseIt","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Extract Services","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Intelligence","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Production Sandbox Environment","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"SAP Integration","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"Select Care","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"TripLink","serviceDescription":"","dateAvailable":"2024-01-17"},{"serviceName":"User Support Desk for Public Sector","serviceDescription":"","dateAvailable":"2024-01-17"}],"third_party_information_resources":{"certified":[{"fedRampCertifiedThirdPartyInformationResource":"FR2607452240","useCase":""}],"nonCertified":[]},"independent_assessor_id":"136571","status_date":"2024-01-17T05:00:00.000Z","cap_date":null,"service_desc":"Concur Cloud for Public Sector (CCPS) is a Government-Only Community Cloud environment that hosts SAP Concur’s extensive suite of travel and expense cloud solutions, hosted on AWS GovCloud Infrastructure. CCPS is designed for the U.S. Public Sector, managed by SAP Concur personnel on U.S. soil, and ensures data security, confidentiality, and availability without compromising usability standards of travel and spend management solutions. SAP Concur U.S. soil requirements do not necessarily extend to external services leveraged by CCPS. Customers can be federal, state, local, tribal, territorial, federally funded research centers (FFRDCs), contractors working on behalf of the government, or lab entities. Concur Cloud for Public Sector provides a comprehensive environment that accommodates the complex processes of government travel and expense. Users are able to access the Federal Travel Regulation (FTR)- and Joint Travel Regulation (JTR)-compliant Concur Cloud applications via standard web browsers or on a smartphone with our SAP Concur mobile app. CCPS brings commercial functionality and scalability to government agencies while still meeting government-mandated security and regulatory needs. \n\nConcur Travel and Expense (CTE): Includes a web application portal to communicate with system users and provide access to all services. The web application gives users the ability to facilitate travel booking services, change travel reservations, and authorize travel. From vouchering services to documenting trip approvals and expense reimbursements, the web application provides accurate accounting information to government systems in compliance with the Federal Travel Regulation (FTR) and the Joint Travel Regulation (JTR). Users access applications within CCPS by using standard web browsers via a URL or by using SAP Concur mobile applications for supported smart phone and tablet computer platforms. All data collected by Concur applications is made available to customers via reporting enabled by the Cognos reporting tool that provides reports and the ability to create and/or manage new reports.\n\nConcurGov: SAP Concur's travel and expense solution provided to U.S. Federal Civilian customers under the ETS2 contract. ConcurGov includes services that are not included with CTE, such as GovPay, within the CCPS CSO.\n\nGlobal Distribution Systems (GDSs): Travel content aggregators that sell content on behalf of airlines, hotels, rail, and rental car companies. Many organizations that provide travel services sell their content only through one or more GDS.\n\nDirect Connect Providers: Travel providers (airlines, hotels, rail, and rental car companies) that do not use GDSs but instead sell their travel content directly.\n\nTravel Management Companies (TMCs): Travel management companies that book travel on behalf of agency users, provide reservation fulfillment, reporting, and mid- and back-office systems as part of the entire end-to-end travel reservation process.\nE-Receipt Providers: Travel providers (airlines, hotels, rail, and rental car companies) that electronically transmit electronic receipts to SAP Concur for inclusion in travel voucher requests.\n\nThe following SAP Concur products and services are available in CCPS: \n•        Advanced Care\n•        Budget\n•        Central Reconciliation\n•        Client Web Services\n•        Company Bill Statements\n•        Consultative Intelligence\n•        Custom Connector – Expense\n•        Data Delivery Services (DDS)\n•        Detect by Oversight\n•        Concur Travel & Expense\n•        Concur Travel only (Direct)\n•        ConcurGov\n•        Concur Expense only\n•        Data Extract Service\n•        Essential Care\n•        ExpenseIt\n•        Extract Services\n•        Intelligent Audit\n•        Intelligence\n•        Production Sandbox Environment\n•        Concur Request\n•        SAP Integration\n•        Select Care\n•        TripLink\n•        User Support Desk for Public Sector\n•        Verify","event_log":[{"date":"2023-01-18T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2023-03-21T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2024-01-17T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},