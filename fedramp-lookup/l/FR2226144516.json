{"id":"FR2226144516","current":{"csp":"MARi, LLC","cso":"MARi","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-04-03T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Data Management","Education & Training","Human Resources"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"QENZCVXK8845","service_acronym":"MARi","website":"https://mari.com/","sales_email":"nancy.belmont@mari.com","security_email":"john.carney@mari.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2025-04-03T04:00:00.000Z","cap_date":null,"service_desc":"MARi is an enterprise-wide, cloud-based, AI-driven Career Intelligence platform for academic and workplace skills. MARi can consume large sets of heterogeneous data and longitudinally track a person's knowledge, skills, and abilities throughout their entire life.  \n\nUsing real-time predictive and prescriptive analytics, MARi can match a person with any job or skill, show them the gaps they need to fill to reach their goals, and make recommendations on how to close those gaps. We call this, ”match-gap-recommend.”\n\nAn intelligent “whole-person” skill repository allows MARi to apply predictive and prescriptive algorithms for both individuals and teams. This enables real-time and over-time proficiency visualizations for both current and future jobs/tasks.\n\nMARi is a versatile platform that supports many learning, training, and career management  functions:\n\n•\tLearning Record Store (LRS)\n•\tLearning Management System (LMS)\n•\tLearning Analytics\n•\tAssessment Engine\n•\tCompetency Tracking\n•\tCareer Pathways\n•\tAI/ML-based Knowledge Repository for Multimedia Knowledge Objects (KOs)","event_log":[{"date":"2023-12-05T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-01-27T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-04-03T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"01/28","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-04-03","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-04-03","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2023-12-05","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2025-01-27","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2025-04-03","kind":"status","source":"status_log","from":"FedRAMP In Process","to":"FedRAMP Certified","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-04-14",