{"id":"FR2214346691","current":{"csp":"Secunetics, Inc.","cso":"Gobo Framework (Gobo)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2022-08-01T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"X2ELLBKRDJF9","service_acronym":"Gobo Framework (Gobo)","website":"https://www.secunetics.com/gobo","sales_email":"fedramp@secunetics.com","security_email":"fedramp@secunetics.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2022-08-01T04:00:00.000Z","cap_date":null,"service_desc":"Gobo provides an intuitive, AI-enabled cognitive automation platform designed to analyze complex datasets, apply intelligent operational logic, and streamline workflows across enterprise IT infrastructure, services, and business processes. The Gobo platform is built to bring actionable intelligence to light, prioritizing simplicity of use, speed of results, and quality of outcomes. Through secure, web-based applications called I2Apps, Gobo automates routine engineering and operations tasks while maintaining strict human-in-the-loop control, auditability, and governance. As a vendor-agnostic platform, Gobo integrates seamlessly with existing systems and data environments, empowering federal agencies to modernize their operations while avoiding costly vendor lock-in.\r\n\r\nTo support diverse agency missions, Gobo delivers core capabilities across three key operational areas:\r\nAI-Enabled Cognitive Automation: Gobo applies semantic intelligence to help agencies empower personnel to automate complex, data-intensive tasks at scale. As a prime example of this capability, Gobo modernizes public comment analysis and regulatory review management. Alongside this, Gobo features intelligent agents to orchestrate complex administrative and technical processes with speed, precision, and reliable predictability.\r\nInfrastructure Digital Twin (IDT) and Performance Management: Leveraging Gobo's IDT capabilities, the platform provides deep, continuous visibility to enable secure, unified, and adaptive IT ecosystems. Gobo streamlines complex migrations with Service Transition Management, facilitating structured transition planning and tracking for critical federal mandates such as the IPv6 transition. This is supported by automated Configuration Management, and Capacity Planning, alongside real-time performance tracking to optimize network operations and ensure system availability.\r\nEnterprise Infrastructure Solutions (EIS) Support: To automate administrative oversight, Gobo streamlines GSA EIS service management, allowing agencies to monitor how well telecommunications service providers meet promised service levels. The platform provides precision Contract Line Item Number (CLIN) and Invoice Management to track line items, automate invoice reconciliation, and facilitate dispute resolution. This capability operates alongside continuous SLA and Service Inventory Management to track the full lifecycle of agency IT assets and recover service provider credits.","event_log":[{"date":"2022-03-18T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-03-18T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"202