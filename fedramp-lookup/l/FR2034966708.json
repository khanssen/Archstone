{"id":"FR2034966708","current":{"csp":"End To End Computing","cso":"Singularity","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Linford & Company","partnering_agency":null,"annual_assessment":null,"cert_date":"2023-02-03T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Collaboration","Customer Service","Cybersecurity & Risk Management","Network Management","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Singularity","website":"https://eecomputing.com/singularity/","sales_email":"sales@eecomputing.com","security_email":"security@eecomputing.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"140531","status_date":"2023-02-03T05:00:00.000Z","cap_date":null,"service_desc":"End To End Computing's (EEC) Singularity is a SaaS-based Managed Security Service platform providing customers with MSSP services such as CISO\\ISSO support, Security Operation Centers (SOC), and DevSecOps. The Singularity platform consists of two modules, Continuous Monitoring (CM) and DevSecOps. Both modules can also be leveraged to provide shared cybersecurity services across organizations and departments.\n\nSingularity CM - The Continuous Monitoring module provides 24/7 SOC support enabling organizations with the visibility required to effectively manage risk. EEC managed SOC utilizes the module to conduct incident response, Managed Detection Response(MDR), Managed SIEM and vulnerability management services. Additionally, the executive dashboard provides agencies with the ability to manage Plan of Action Milestones (POAMs) with ease. \n\nSingularity DevSecOps - This is a Comprehensive CI\\CD pipeline to enable organizations to deliver holistic, all-in-one solutions that protect applications from the inside while simplifying implementation across a range of environments. Organizations can leverage the capabilities of the platform to protect applications from the beginning of the application development process to solve the root causes of risks, as well as after the applications are placed in production. This is done by providing organizations with access to Static Application Security Testing (SAST), Dynamic Application Security Testing (DAST), Runtime Application Self Protection (RASP), and Interactive Application Security Testing (IAST) capabilities to protect applications from cyber threats.","event_log":[{"date":"2022-03-17T04:00:00.000Z","category":"Status Change","description":"Status set to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2022-03-21T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2023-02-03T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"03/21","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2023-02-03","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2023-02-03","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2022-03-17","ki