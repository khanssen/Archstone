{"id":"FR2620739750","current":{"csp":"VisibleThread","cso":"VisibleThread","status":"Legacy FedRAMP Ready","phase":"Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Ignyte Platform Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Artificial Intelligence (AI)","Collaboration","Content Management System (CMS)","Data Management","Governance, Risk, and Compliance (GRC)","Legal & Policy","Marketing & Sales"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"MJWYNX1KNQW8","service_acronym":"VisibleThread","website":"https://www.visiblethread.com/","sales_email":"info@visiblethread.com","security_email":"security@visiblethread.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201722","status_date":"2026-07-08T22:13:58.248Z","cap_date":null,"service_desc":"VisibleThread is a Software-as-a-Service (SaaS) application that provides automated document and language analysis for United States government contracting teams across the opportunity, capture, proposal, and contract phases of the acquisition lifecycle.\n\nThe service combines deterministic text analysis and pattern matching with generative AI functions to search, extract, draft, score, and compare document content. Analytical outputs reference the source text from which they are derived, providing traceability from each result back to the originating document.\n\nFunctional capabilities include opportunity search and bid or no-bid scoring, competitive and technical alignment analysis, compliance matrix generation and document comparison, acronym and readability analysis, terminology and tone consistency checks, AI-assisted drafting that references prior submitted content and past performance material, and contract risk and redline analysis.\n\nWork within the service is organized into Workspaces. A Workspace is a logical container that partitions a team's content and configuration, allowing an organization to separate work by line of business, program, customer, or security boundary. Each Workspace maintains its own independent set of:\n\n- Collections of curated reference content\n- Prompt Library\n- Search Dictionaries and Watchword Lists\n- Contracts and reference contract sets\n- Sales, capture, and proposal lifecycle stages\n\nAccess to each Workspace is controlled independently, so that content and configuration in one Workspace are not exposed to users of another. The service integrates with Microsoft SharePoint, allowing documents to be synchronized from customer-managed SharePoint locations into a Workspace's Collections for analysis.","event_log":[{"date":"2026-07-08T22:13:58.248Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"impact_level":{"value":"Moderate","as_of":"2026-07-09","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ready_date":{"value":"2026-07-07","as_of":"2026-07-09","source":"old_feed","shown_until":"2026-11-03","label":"ready_date"},"ready_status":{"value":"2026-07-07","as_of":"2026-07-09","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP Ready status"}},"timeline":[{"date":"2026-07-08","kind":"status","source":"status_log","from":null,"to":"FedRAMP Ready","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-07-08"},{"date":"2026-07-09","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"VisibleThread"},{"date":"2026-07-09","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"