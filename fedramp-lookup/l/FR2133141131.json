{"id":"FR2133141131","current":{"csp":"Nintex","cso":"Nintex Automation GE Platform","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Lunarline, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2024-03-19T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Collaboration","Communication","Content Management System (CMS)","Customer Relations Management (CRM)","Data Management","Human Resources","Marketing & Sales","Operations Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Nintex Automation GE Platform","website":"https://www.nintex.com/","sales_email":"sales@nintex.com","security_email":"securitycompliance@projecthosts.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137004","status_date":"2024-03-19T04:00:00.000Z","cap_date":null,"service_desc":"Nintex Automation GE Platform (Nintex GE) is delivered as SaaS offering using a multi-tenant Government Only cloud computing environment. It is available to the DoD, federal, state, local and tribal government communities as well as their respective contractors.\r\nThe Nintex Automation GE Platform (Nintex GE) solution is a suite of SaaS products available that allows government entities to automate both simple and sophisticated business processes, such as approving and signing documents, or hiring and onboarding employees.\r\nWith a simple drag-and-drop, no-code interface, users can design workflows, forms, and tasks, and integrate third-party platforms such as Salesforce, Microsoft Office, Zendesk and more, and create a seamless experience that minimizes manual touchpoints and streamlines efficiency.\r\nThrough Workflow Connections, organizations control which third-party services they connect their workflows to, and know their data is secure and compliant throughout the process.\r\nThe Nintex GE system via DocGen further provides agencies leveraging Salesforce the ability to generate precise and accurate documents for sophisticated business functions like recruiting documents, contracts, or work orders, all without leaving their Salesforce environment or the need for code. This allows users to create, manage and generate document packages within Salesforce in both Lightning or Classic, without losing the benefits of an easy-to-use and familiar user experience. Users can output data to a variety of endpoints and know their document data is secure and compliant throughout the process.","event_log":[{"date":"2023-03-08T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2023-03-13T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2024-03-19T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"03/11","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2024-03-19","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2024-03-19","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2