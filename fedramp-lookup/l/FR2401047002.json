{"id":"FR2401047002","current":{"csp":"Axonius Federal Systems","cso":"Axonius Asset Cloud","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":"2025-04-03T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Cybersecurity & Risk Management","Mobile Device Management (MDM)","Network Management","Operations Management","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Axonius Asset Cloud","website":"https://www.axoniusfed.com/","sales_email":"info@axoniusfed.com","security_email":"cyber@axoniusfed.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2025-04-03T04:00:00.000Z","cap_date":null,"service_desc":"Axonius Asset Cloud is a SaaS offering using a single-tenant Public Cloud computing environment to provide customers with a comprehensive solution for managing their assets, both on-premises and in the cloud, optimizing their IT operations, and ensuring the security and compliance of their assets.\r\n \r\nWith Axonius Asset Cloud, organizations can discover and track their hardware and software assets, including servers, laptops, desktops, mobile devices, cloud-based applications, and identities and accounts. The software automatically collects data from a variety of sources, including network devices, operating systems, and third-party applications, and presents it in an easy-to-use dashboard. In addition to asset management, the solution offers SaaS management capabilities, allowing organizations to monitor and control their cloud-based applications and services. With Axonius Asset Cloud, organizations can gain insights into their SaaS usage, track license compliance, and optimize their cloud spend. Moreover, the solution provides advanced security features, including continuous monitoring and compliance checks, to ensure that assets are secure and compliant and provides a unified view of risk across the customer IT environment. It also integrates with existing security tools and workflows, making it easy to manage and remediate security issues. This solution enables organizations to gain extensive visibility into their assets, both on-premises and in the cloud, and manage them effectively.","event_log":[{"date":"2023-11-30T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2024-09-19T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2025-04-03T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"09/19","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2025-04-03","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2025-04-03","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"Centers for Medicare & Medicaid Services","as_of":"2026-06-