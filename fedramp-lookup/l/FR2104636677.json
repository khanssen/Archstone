{"id":"FR2104636677","current":{"csp":"Ipsos America, Inc.","cso":"Ipsos Research","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2021-12-21T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Ipsos Research","website":"https://www.ipsos.com/en-us/solutions/list?search=Public%20Affairs","sales_email":null,"security_email":"global_security@ipsos.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2021-12-21T05:00:00.000Z","cap_date":null,"service_desc":"Ipsos: Multi-Modal Survey Research and AI-Powered Data Analytics for the Public Sector\n\nIpsos delivers a secure, FedRAMP Moderate Authorized platform designed to help federal agencies gather critical data and translate it into actionable intelligence. We provide end-to-end support for the entire research lifecycle, from survey design and deployment to advanced, AI-driven analysis.\n\nCore Capabilities:\n\nOur platform supports a full range of data collection methods to reach any audience, including:\n\n* Digital Surveys: Modern, responsive web-based surveys with the capability to distribute invitations via email and SMS.\n* Paper-Based Logistics: We manage the complete paper survey lifecycle, partnering with vetted vendors for printing and mailing, while handling all high-speed scanning and data capture in-house.\n \nNext-Generation AI Analytics:\n\nOur platform securely accesses a suite of leading Large Language Models (LLMs) through AWS Bedrock, a managed service that has achieved FedRAMP High authorization. This allows us to transform vast amounts of unstructured text from open-ended survey responses into clear, data-driven insights. Our AI engine can:\n\n* Automatically Classify Verbatims: Instantly categorize thousands of qualitative responses into key themes.\n* Extract Actionable Insights: Identify and summarize key takeaways, emerging trends, and critical recommendations.\n* Enhance Data Quality and Security: Automatically identify and flag comments containing extreme keywords or potential Personally Identifiable Information (PII) for manual review, redaction, and follow-up, ensuring data integrity and compliance.\n* Generate Executive Summaries: Produce concise narratives to support rapid and informed decision-making.\n \n\nWhy Ipsos for Government?\n\nOur combination of multi-modal survey expertise and secure, AI-powered analytics empowers public sector organizations across all verticals—including healthcare, defense, and civilian agencies—to understand public sentiment, evaluate program effectiveness, and make mission-critical decisions with greater speed and confidence. All data is managed within our secure GovCloud environment, adhering to the strictest contractual and regulatory standards.","event_log":[{"date":"2021-02-18T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2021-02-18T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2021-12-21T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"02/18","as_of":