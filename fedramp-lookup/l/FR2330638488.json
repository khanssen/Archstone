-text), metadata, multi-lingual, hierarchical, and geospatial (visual) across all data types.\n\n●            Tools for index-in-place or ingesting data into a single repository, able to read/write/tag metadata during or after ingestion.\n\n●            Extensive administrative tools with security and protected access and reporting on both usage and data with pre-configured and ad-hoc reporting in the system.","event_log":[{"date":"2024-05-23T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2024-05-23","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Agency In Process status"},"partnering_agency":{"value":"Department of the Navy","as_of":"2026-06-24","source":"old_feed","shown_until":"2026-06-25","label":"Sponsor"}},"timeline":[{"date":"2024-05-23","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"PTFS/Liblime"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"Bibliovation/Knowvation"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"status","label":"Status","from":null,"to":"FedRAMP In Process"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"impact_level","label":"Impact level","from":null,"to":"Moderate"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cert_path","label":"Path","from":null,"to":"Agency"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"independent_assessor","label":"Assessor","from":null,"to":"Lazarus 