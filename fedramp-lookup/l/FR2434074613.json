{"id":"FR2434074613","current":{"csp":"NormShield, Inc. DBA Black Kite","cso":"Third-Party Risk Intelligence System (TRIS)'s","status":"Legacy FedRAMP Ready","phase":"Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Linford & Company","partnering_agency":null,"annual_assessment":null,"cert_date":null,"under_cap":false,"service_model":["SaaS"],"deployment_model":"Public Cloud","business_categories":["Analytics","Cybersecurity & Risk Management"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Third-Party Risk Intelligence System (TRIS)'s","website":"https://gov.blackkitetech.com/","sales_email":"marketing@blackkite.com","security_email":"security@blackkite.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"140531","status_date":"2026-03-25T04:00:00.000Z","cap_date":null,"service_desc":"Black Kite is delivered as a SaaS offering using a multi-tenant public cloud computing environment. It is available to the public, federal, state, local, and tribal governments, as well as research institutions, federal contractors, government contractors etc. Black Kite offers a separate configuration for federal/public sector customers to maintain the highest possible level of information security. Black Kite provides a defensive platform that spans the entirety of the third-party risk management life cycle for cyber risk professionals looking to quantify and maintain visibility of their risk exposure.\nBlack Kite’s core application, is a multi-user, transaction-based application suite that gives a three-dimensional risk picture of a company and its vendors through:\n• A cyber risk technical assessment.\n• A factor analysis of information risk (FAIR) analysis (the probable financial impact of a breach caused by a vendor).\n• An external estimate of compliance (assessing that vendors have appropriate policies and processes in place).\n• Executives get an easy-to-understand “Cyber Risk Report” with letter grade scores.\n• IT security teams can drill down to the technical details behind each risk category.\n• Risks/vulnerabilities are prioritized by severity so that security engineers can quickly identify critical issues and mitigate them.\n• Industry benchmarks and comparisons are provided to help identify trends and pinpoint areas for improvement.\n• Grading is based on industry standards and best practices (NIST, MITRE CVSS, FAIR, etc.)","event_log":[{"date":"2026-03-25T04:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ready_date":{"value":"2026-03-25","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"ready_date"},"ready_status":{"value":"2026-03-25","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP Ready status"}},"timeline":[{"date":"2026-03-25","kind":"status","source":"status_log","from":null,"to":"FedRAMP Ready","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"NormShield, Inc. DBA Black Kite"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"cso","label":"Offering","from":null,"to":"Third-Party Risk Intelligence System (TRIS)'s"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"status","label":"Status","from":null,"to":"FedRAMP Ready"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"impact_level","label":"Impact level","from