{"id":"FR2234256499","current":{"csp":"Rubrik","cso":"Rubrik Security Cloud - Government (RSC-G)","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Fortreum, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2024-12-10T05:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Analytics","Cybersecurity & Risk Management","Data Management","Storage"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"HHKMMMELQG55","service_acronym":"Rubrik Security Cloud - Government (RSC-G)","website":"https://www.rubrik.com/","sales_email":"rscgsales@rubrik.com","security_email":"rscgsoc@rubrik.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201664","status_date":"2024-12-10T05:00:00.000Z","cap_date":null,"service_desc":"Rubrik Security Cloud Government (RSC-G) is a cyber resilience and data security platform designed for federal, state, and local governments, and educational institutions to secure data across enterprise, cloud, and SaaS applications. The service is hosted in a dedicated, U.S. based sovereign cloud instance and is built on Zero Trust Data Security principles. The platform utilizes a purpose built file system that is inherently immutable, safeguarding data integrity and availability through air gapped and access controlled backups.\n\nThe platform integrates data protection with advanced cybersecurity capabilities, allowing agencies to proactively reduce risk by identifying sensitive data exposure and detecting anomalous activity via machine learning engines. RSC-G provides centralized management for data residing in on premises data centers, cloud environments, and SaaS applications through automated discovery and policy driven protection.\n\nIn the event of a cyberattack, RSC-G enables rapid mission continuity by providing automated threat containment and surgical recovery of affected applications and data. These capabilities are designed to eliminate the risk of malware reinfection during the restoration process. The service includes specialized tools to protect large scale unstructured data sets and the restoration of identity provider objects, ensuring the integrity of the identity control plane and overall operational continuity.\n\n\nAvailable services as part of Rubrik Security Cloud - Government\nData Protection & Backup Services\n●        Virtualization: VMware vSphere, VMware Cloud Director (VCD), Microsoft Hyper-V, Nutanix AHV, Proxmox\n●        Containers: K8s / KubeVirt, OpenShift / OpenShift Virtualization\n●        Databases: Microsoft SQL Server, Oracle Database, SAP HANA, PostgreSQL, MySQL, MongoDB, IBM DB2\n●        Operating Systems: Linux (RHEL, CentOS, Ubuntu), Microsoft Windows Server\n●        Unstructured Data: NAS (NFS/SMB), Managed File Shares\nData Security & Recovery Operations\n●        Threat Monitoring: Anomaly Detection and Ransomware Investigation\n●        Sensitive Data Discovery: Data Classification and Exposure Analysis\n●        Orchestrated Recovery: Blueprint based recovery for complex application stacks\nCloud and SaaS Resilience Services\n●        Cloud Native Workloads: Amazon EC2, Amazon EBS, Amazon RDS, Amazon S3, Azure VM, Azure SQL, Azure Blob, GCP VM & Volumes\n●        SaaS Platforms: Data protection for Salesforce and Microsoft 365 (Exchange, OneDrive, SharePoint, Teams)\nEnhanced Resilience and Archival Services\n●        Rubrik Cloud Vault: Provides a managed, isolated cloud repository for offsite data storage and logical air gapping.\n●        Identity Recovery: Provides backup and point in time restoration for Microsoft Active Directory and Microsoft EntraID objects to maintain the integrity of identity and access management systems.","event_log":[{"date":"2023-05-24T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2024-01-17T05:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2024-12-10T05:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"01/17","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2024-12-10","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2024-12-10","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"partnering_agency":{"value":"National Nuclear Security Administration","as_of":"2026-06-25","source":"old_feed","shown_until":"2026-11-03","label":"Sponsor"}},"timeline":[{"date":"2023-05-24","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2024-01-17","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2024-12-10","kind":"status","source":"status_log","from":"FedRAMP In Process","to":"FedRAMP Certified","track":"Rev5","path":"Agency","class":"Class C","recorded"