{"id":"FR2115384377","current":{"csp":"Commvault Systems, Inc.","cso":"Commvault Cloud for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Coalfire Systems, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2024-05-16T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"XAXKNJGAZ4H2","service_acronym":"Commvault Cloud for Government","website":"https://www.commvault.com/news/introducing-commvault-cloud-powered-by-metallic-ai","sales_email":"ccarter@commvault.com","security_email":"FedRAMP_Security@commvault.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[{"serviceName":"Air Gap Protection Hybrid cloud for Commvault Complete™ and HyperScale™ X deployments","serviceDescription":"","dateAvailable":"2024-05-17"},{"serviceName":"Data Protection for Active Directory","serviceDescription":"","dateAvailable":"2024-05-17"},{"serviceName":"Data Protection for Azure VM Kubernetes Microsoft Hyper-V VMWare AWC EC2 VMWare Cloud","serviceDescription":"","dateAvailable":"2024-05-17"},{"serviceName":"Data Protection for Database (Microsoft SQL Oracle SAP HANA)","serviceDescription":"","dateAvailable":"2024-05-17"},{"serviceName":"Data Protection for Dynamics 365, Data Protection for Salesforce","serviceDescription":"","dateAvailable":"2024-05-17"},{"serviceName":"Data Protection for Endpoints","serviceDescription":"","dateAvailable":"2024-05-17"},{"serviceName":"Data Protection for File & Object (Windows Server Azure Blob & Files OCI Object Storage Amazon S3 Linux/Unix)","serviceDescription":"","dateAvailable":"2024-05-17"},{"serviceName":"Data Protection for Microsoft 365 (Exchange Teams SharePoint and OneDrive)","serviceDescription":"","dateAvailable":"2024-05-17"}],"third_party_information_resources":null,"independent_assessor_id":"138514","status_date":"2024-05-16T04:00:00.000Z","cap_date":null,"service_desc":"Commvault Cloud for Government delivers a fully automated cyber resilient SaaS data backup and recovery solution, with automated deployment, reduced overhead, automated patching and upgrades, continuous security monitoring, and requiring no Agency maintenance. Fully differentiated storage enables the move to cloud by providing the option to leverage cloud or on-premises storage within the web console for hybrid cloud workloads that require synchronization to sustain operational readiness and mission delivery.\r\n\r\nCommvault Cloud for Government capabilities include the following workloads:\r\n\r\n-Microsoft 365 - For Exchange, Teams, SharePoint, and OneDrive\r\n-Dynamics 365 - For CE applications + Power Platform\r\n-Salesforce - For Salesforce\r\n-Active Directory - For Entra ID and Active Directory\r\n-VM & Kubernetes – Azure VM, Kubernetes, Microsoft Hyper-V, VMWare, AWC EC2, VMWare Cloud\r\n-Endpoint – For Laptops and Desktops\r\n-File & Object – For Windows Server, Azure Blob & Files, OCI Object Storage, Amazon S3, Linux/Unix\r\n-File & Object Archive – For compliance ready archiving\r\n-Database – For Microsoft SQL, Oracle, SAP HANA\r\n-Air Gap Protection (AGP) – secure and scalable cloud storage from Azure in minutes, delivering against your organization’s hybrid cloud strategy is available for Commvault Complete™ and HyperScale™ X deployments.\r\nThe web-based console, called Command Center, provides a holistic customer data platform with both default and customizable configurations, -automated procedures for critical data protection and recovery tasks. Command Center delivers fully automated alerts on pre-set data anomalies, integrated audit reports, key word search (e.g., identifying PII or potential data spillages) and the ability remediate data issues at the granular level (e.g., file, specific email) using integrated indexing and metadata tags designed to protect data at IL4 & IL 5.","event_log":[{"date":"2021-05-24T04:00:00.000Z","category":"Status Change","description":"Status set to Legacy FedRAMP Ready","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2022-06-10T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP Ready to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2023-07-12T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2024-05-16T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"annual_assessment":{"value":"07/12","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2024-05-16","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2024-05-16","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ready_date":{"value":"2021-05-24","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"ready_date"}},"timeline":[{"date":"2021-05-24","kind":"status","source":"status_log","from":null,"to":"FedRAMP Ready","track":"Rev5","path":"Agency","class":"Class D","recorded":"2026-04-22"},{"date":"2022-06-10","kind":"status","source":"status_log","from":"FedRAMP Ready","to":"Agency Authorization In Process