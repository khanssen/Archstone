{"id":"FR2618046015","current":{"csp":"Cyera","cso":"Cyera for Government","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D","impact_level":"Unknown","independent_assessor":"Schellman Compliance, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2026-10-20T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Hybrid Cloud","business_categories":["Cybersecurity & Risk Management","Data Management","Storage","System Administration"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"T9M2M1H16HS9","service_acronym":"Cyera for Government","website":"https://cyera.io/","sales_email":"fedramp-sales@cyera.io","security_email":"fedramp-operations@cyera.io","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"136571","status_date":"2026-10-20T04:00:00.000Z","cap_date":null,"service_desc":"Cyera for Government is an agentless, cloud-native SaaS data security platform.  Cyera for Government provides continuous visibility, AI-powered data classification, and protection for federal data across hybrid-cloud, SaaS, and on-premises environments. The system functions as a centralized data security control plane, enabling agencies to discover sensitive information, assess risk posture, and enforce security policies in real-time. By unifying Data Security Posture Management (DSPM) with advanced Data Loss Prevention (DLP) and Artificial Intelligence Security Posture Management (AI-SPM), the platform provides the foundation for securing the federal AI lifecycle.\nCyera for Government enables the automated discovery and contextual classification of structured and unstructured data. It utilizes an AI-native classification engine to identify Federal Information, including Personally Identifiable Information (PII), Protected Health Information (PHI), and Controlled Unclassified Information (CUI).\nBeyond discovery, the platform delivers automated risk remediation and continuous monitoring to close security gaps before they are exploited. By analyzing data access patterns and permissions, Cyera identifies over-privileged users and \"shadow data\" that bypasses traditional controls. This proactive approach allows agencies to implement Zero Trust Data Access (ZTDA) architectures, ensuring that sensitive federal assets remain resilient against insider threats and external breaches.\nCyera for Government is specifically engineered to streamline regulatory compliance with federal mandates such as NIST 800-53, CMMC, HIPAA, and FISMA. The platform provides out-of-the-box reporting and audit trails that simplify the assessment and authorization process.","event_log":[{"date":"2026-04-01T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2026-08-24T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"},{"date":"2026-10-20T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class D"}]},"kept":{"impact_level":{"value":"High","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2026-04-01","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Agency In Process status"},"partnering_agency":{"value":"Cybersecurity & Infrastructure Security Agency","as_of":"2026-06-24","source":"old_feed","shown_until":"2026-06-25","label":"Sponsor"}},"timeline":[{"date":"2026-04-