{"id":"FR1828848692","current":{"csp":"OneSpan Inc.","cso":"OneSpan Sign, E-Signature and Digital Signature Service","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Lunarline, Inc.","partnering_agency":null,"annual_assessment":null,"cert_date":"2019-05-03T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Hybrid Cloud","business_categories":["Accounting","Collaboration","Content Management System (CMS)","Customer Relations Management (CRM)","Cybersecurity & Risk Management","Human Resources","Legal & Policy","Marketing & Sales","Operations Management","Storage"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"OneSpan Sign, E-Signature and Digital Signature Service","website":"https://www.onespan.com/fedramp","sales_email":"fedramp@onespan.com","security_email":"security@onespan.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137004","status_date":"2019-05-03T04:00:00.000Z","cap_date":null,"service_desc":"OneSpan Sign has been helping government organizations move to paperless signing since 1997, making it the longest standing electronic signature solution in the U.S. Federal Government. As the first e-signature and digital transaction management solution granted ATO under FedRAMP, OneSpan Sign helps digitize and automate manual, paper-based processes in support of the government's digital transformation efforts. OneSpan Sign features include templates, workflow automation, mobile and offline signing, transaction management and comprehensive audit trails. OneSpan Sign also meets the government's stringent authentication requirements with out-of-the-box support f