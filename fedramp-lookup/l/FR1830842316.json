{"id":"FR1830842316","current":{"csp":"Leidos Digital Solutions, Inc.","cso":"IQ FedCloud","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Fortreum, LLC","partnering_agency":null,"annual_assessment":null,"cert_date":"2019-07-10T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":["Communication","Customer Relations Management (CRM)","Customer Service"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":"R8DWHMDFAFF1","service_acronym":"IQ FedCloud","website":"https://leidosiq.com/federal-government/","sales_email":"R_DSI-Fedramp@leidos.com","security_email":"IQFedramp_IR@Leidos.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"201664","status_date":"2019-07-10T04:00:00.000Z","cap_date":null,"service_desc":"IQ FedCloud is delivered as a SaaS offering using a multi-tenant Government-Only Cloud computing environment. It is available to federal, state, local, and tribal governments.\r\n\r\nIntranet Quorum (IQ) and the FedRAMP authorized implementation, IQ FedCloud, is a SaaS application offering Customer Relationship Management (CRM), correspondence management, Casework, business process management (BPM) and workflow. IQ is commonly used to support both constituent and agency needs ranging from simple task management to complex Freedom of Information (FOIA) requests. IQ’s core modules include Contacts, Messages, Outreach, Services, Library, and Events which combine to help agencies and elected officials to keep a complete history of their communications and manage their suspense tracking needs. IQ streamlines document management processes including approval for electronic signature and resolution. Robust reporting capabilities enhance data analytics for executive awareness and review. IQ lets users securely exchange record data with other agencies with the unique IQ2IQ capability. IQ addresses a wide range of executive management needs including grants, investigations, Boards and Commissions, communications, and records management and retention.  A no code solution, IQ is fully configurable without custom development.","event_log":[{"date":"2018-09-10T04:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2019-04-29T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2019-07-10T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"04/29","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2019-07-10","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2019-07-10","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"}},"timeline":[{"date":"2018-09-10","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2019-04-29","kind":"status","source":"status_log","from":"Agency Authorization In Process","to":"FedRAMP In Process","track":"Rev5","path":"