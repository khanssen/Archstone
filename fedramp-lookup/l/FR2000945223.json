{"id":"FR2000945223","current":{"csp":"Software AG Government Solutions","cso":"ARIS Government Cloud","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"Kratos","partnering_agency":null,"annual_assessment":null,"cert_date":"2020-07-09T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Government Community Cloud","business_categories":[],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"ARIS Government Cloud","website":"https://aris.com/","sales_email":null,"security_email":"jonathan.strzalka@aris.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"137255","status_date":"2020-07-09T04:00:00.000Z","cap_date":null,"service_desc":"ARIS Government Cloud is a platform hosted on AWS GovCloud Kubernetes Infrastructure, offering both dedicated and multi-tenant environments for U.S. government users. Tailored to meet the strictest security standards, ARIS Government Cloud is managed and operated by only U.S. Persons, the solution ensures the highest levels of data security, confidentiality, and availability, empowering government operations to optimize and govern their business processes effectively.\n\n \n\nARIS provides a comprehensive platform to model, analyze, and optimize business processes across government operations. The solution supports all stages of business process management, from process discovery to design, analysis, and continuous improvement. With integrated reporting and data analytics capabilities, ARIS helps users identify inefficiencies, mitigate risks, and improve service delivery while ensuring full compliance with federal guidelines.\n\n \n\nKey Capabilities:\n\nBusiness Process Modeling (BPM): ARIS enables users to map, simulate, and refine processes, ensuring both operational efficiency and regulatory adherence at every step.\nGovernance, Risk, and Compliance (GRC): ARIS delivers a comprehensive framework for maintaining federal compliance, offering robust governance tools, audit trails, and risk management functionalities to safeguard data integrity.\nProcess Mining: The platform’s real-time analytics drive data-informed decision-making, helping users enhance accountability and continuously optimize operations.\n \n\nALFABET is the premier solution for Enterprise Architecture (EA), IT Planning, and Strategic Portfolio Management (SPM). Recognized as a leader in the Gartner EA Magic Quadrant for over 17 consecutive years, Alfabet stands out as the only top-tier solution featured in both the EA and SPM Magic Quadrants. It continues to maintain its FedRAMP authorization under the ARIS registration.","event_log":[{"date":"2019-11-05T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2020-05-20T04:00:00.000Z","category":"Status Change","description":"Status changed from Agency Authorization In Process to FedRAMP In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2020-07-09T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"12/09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2020-07-09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2020-07-09","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization