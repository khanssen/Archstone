{"id":"FR2600545894","current":{"csp":"Butterfly Network Inc.","cso":"Butterfly Network Ultrasound","status":"FedRAMP Certified","phase":"Ongoing Certification","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C","impact_level":"Unknown","independent_assessor":"A-LIGN Compliance and Security, Inc. dba A-LIGN","partnering_agency":null,"annual_assessment":null,"cert_date":"2026-08-26T04:00:00.000Z","under_cap":false,"service_model":["SaaS"],"deployment_model":"Hybrid Cloud","business_categories":["Analytics","Collaboration","Customer Service","Cybersecurity & Risk Management","Data Management","Education & Training","Fleet Management","Health & Wellness","Research"],"fedramp_msg":"","ready_status":"Unknown","ip_jab_status":"Unknown","ip_pmo_status":"Unknown","ip_agency_status":"Unknown","ip_prog_status":"Unknown","small_business":false,"uei":null,"service_acronym":"Butterfly Network Ultrasound","website":"https://www.butterflynetwork.com/","sales_email":"salesops@butterflynetinc.com","security_email":"security@butterflynetinc.com","trust_center":null,"secure_configuration_guidance":null,"certified_services":[],"third_party_information_resources":null,"independent_assessor_id":"138665","status_date":"2026-08-26T04:00:00.000Z","cap_date":null,"service_desc":"Butterfly Network’s Inc.’s Butterfly iQ+ / iQ3 Ultrasound System/ Compass AI (aka Butterfly Ultrasound Probe System) enables universal access to superior medical imaging, making high quality ultrasound easy-to-use, globally accessible, and intelligently connected.\n\nButterfly Ultrasound Probe System is the only ultrasound transducer that can perform “whole-body imaging” with a single handheld probe using semiconductor technology. Connected to a mobile phone or tablet, it is powered by Butterfly’s proprietary Ultrasound-on-Chip™ technology and harnesses the advantages of AI to deliver advanced imaging that is easy-to-use and improves patient outcomes.\n\nThe primary function of the Butterfly App is general-purpose diagnostic imaging, for use by qualified and trained healthcare professionals to enable the visualization and measurement of anatomical structures within the human body. The app is a free download from the Apple App Store or Google Play Store. The app and a vetted Butterfly account are required to use the Butterfly Ultrasound Probe System.\n\nThe Butterfly Cloud is hosted by Amazon Web Services (AWS) in multi availability zone fashion with cross-region data replication.\n\nThe development environment is where the initial software creation and code revision occurs. It's an area for developers to freely work on new updates without affecting the live application.\n\nThe staging environment, also known as the Quality Assurance (QA) environment, is the intermediary step where the software is tested in conditions that closely mirror the production environment. This is where thorough checks are conducted before any release.\n\nThe production environment is the live setting where the software is fully deployed for use by the end-users. It is the final and most stable environment, designed for uptime and reliability.\n\nButterfly Ultrasound Probe System offers two primary services: Public Cloud and Private or Enterprise Cloud:\n\nPublic Cloud: Designed for small groups, such as a team using the Butterfly web application, this service allows for the creation of an organization within the cloud. Team members can invite colleagues to join their organization. This multi-tenant approach enables different organizations, like those from various hospitals, to coexist simultaneously within the same public cloud infrastructure.\n\nPrivate Cloud: An upgrade from the public cloud, this service provides a unique domain tailored for specific institutions, such as hospitals, which may establish separate organizations for each department. Additionally, Enterprise Cloud offers enhanced features like Single Sign-On (SSO), allowing users to access the cloud services with their existing institutional credentials. Like the public cloud, multi-tenant approach enables different organizations, like those from various hospitals, to coexist simultaneously within the same private cloud infrastructure.\n\nThe Butterfly Ultrasound Probe System uses industry standard third-party interconnections to provide robust and up to date security tools to protect the integrity of the Butterfly Ultrasound Probe System and related information.","event_log":[{"date":"2026-03-05T05:00:00.000Z","category":"Status Change","description":"Status set to Agency Authorization In Process","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"},{"date":"2026-08-26T04:00:00.000Z","category":"Status Change","description":"Status changed from FedRAMP In Process to FedRAMP Certified","cert_type":"Rev5","cert_path":"Agency","cert_class":"Class C"}]},"kept":{"annual_assessment":{"value":"07/13","as_of":"2026-08-27","source":"old_feed","shown_until":"2026-11-03","label":"Annual assessment"},"auth_date":{"value":"2026-08-26","as_of":"2026-08-27","source":"old_feed","shown_until":"2026-11-03","label":"Authorization date"},"fedramp_auth_date":{"value":"2026-08-26","as_of":"2026-08-27","source":"old_feed","shown_until":"2026-11-03","label":"FedRAMP authorization date"},"impact_level":{"value":"Moderate","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-11-03","label":"Impact level"},"ip_agency_status":{"value":"2026-03-05","as_of":"2026-04-14","source":"old_feed","shown_until":"2026-07-22","label":"Agency In Process status"},"ip_pmo_status":{"value":"2026-07-21","as_of":"2026-07-22","source":"old_feed","shown_until":"2026-08-27","label":"PMO In Process status"}},"timeline":[{"date":"2026-03-05","kind":"status","source":"status_log","from":null,"to":"Agency Authorization In Process","track":"Rev5","path":"Agency","class":"Class C","recorded":"2026-04-22"},{"date":"2026-04-14","kind":"field","source":"old_feed","field":"csp","label":"Provider","from":null,"to":"Butterfly 